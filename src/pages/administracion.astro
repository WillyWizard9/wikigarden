---
import WikiSupabase from '../components/WikiSupabase.astro';
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="robots" content="noindex,nofollow"/><title>Administración · WikiGarden</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
<style>
:root{font-family:Outfit,system-ui,sans-serif;color:#214438;background:#f2f7f3}*{box-sizing:border-box}body{margin:0}main{max-width:720px;margin:6vh auto;padding:20px}.card{background:#fff;border:1px solid #dce9df;border-radius:22px;padding:clamp(22px,5vw,42px);box-shadow:0 16px 50px #133b2010}header{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:30px}a{color:#22785e;text-decoration:none;font-weight:700}h1{font-size:clamp(28px,5vw,40px);letter-spacing:-.04em;margin:5px 0 8px}p{line-height:1.5;color:#5b7567}.eyebrow{font-size:11px;letter-spacing:.13em;font-weight:800;color:#37866b}.form{display:grid;gap:18px;margin-top:25px}label{font-weight:650;display:grid;gap:8px;font-size:14px}input,select{font:inherit;border-radius:10px;border:1px solid #cbddd0;padding:13px;background:#fff;color:#234737;width:100%}input:focus,select:focus{outline:2px solid #67b39c}button{border:0;background:#26785e;color:white;padding:14px 24px;border-radius:12px;font:700 15px Outfit;cursor:pointer}button:disabled{opacity:.6;cursor:wait}.hint{font-size:12px;color:#6d8376}#status{font-size:14px;min-height:22px}#status[data-error]{color:#ae3939}#status[data-success]{color:#20744a}fieldset{border:0;padding:0;margin:0;display:grid;gap:9px}legend{font-weight:700;font-size:14px;margin-bottom:8px} .radio{display:flex;align-items:center;gap:8px;font-size:13px}.radio input{width:auto}.passwordField{position:relative;display:block}.passwordField input{padding-right:104px}.passwordToggle{position:absolute;right:6px;top:50%;transform:translateY(-50%);background:#e7f2ec;color:#245e4b;padding:8px 12px;font-size:12px;border-radius:8px}.passwordToggle:hover{background:#d5e8dd}.passwordToggle:focus-visible{outline:2px solid #26785e;outline-offset:2px}.pendingList{display:grid;gap:10px;margin-top:18px}.pendingRow{display:flex;justify-content:space-between;align-items:center;gap:14px;border:1px solid #dce9df;padding:16px;border-radius:13px;background:#f9fcfa;flex-wrap:wrap}.pendingRow strong{display:block;font-size:14px;overflow-wrap:anywhere}.pendingRow small{display:block;color:#698075;font-size:12px;margin-top:4px}.pendingRow button{font-size:12px;padding:10px 14px;background:#e3f1e9;color:#245d46}.pendingRow button:hover{background:#d3e8dc}.pendingEmpty{font-size:13px;color:#6a8074}.pendingFeedback{font-size:13px;color:#23664b;min-height:20px}.hidden{display:none!important}
</style>
</head>
<body><main><header><a href="/">← WikiGarden</a><span class="eyebrow">ADMINISTRACIÓN</span></header><section class="card">
<span class="eyebrow">GESTIÓN DE ACCESOS</span><h1>Gestionar accesos</h1>
<p>Asigna cada persona a su garden. Puedes enviar una invitación por email o crear una cuenta activa sin enviar correos. Las medallas son individuales.</p>
<p id="status" role="status" aria-live="polite">Comprobando permisos…</p>
<form id="invite" class="form hidden">
<fieldset><legend>Tipo de alta</legend>
<label class="radio"><input type="radio" name="accountMode" value="invite" checked/> Enviar invitación por email</label>
<label class="radio"><input type="radio" name="accountMode" value="direct"/> Crear cuenta activa sin email</label>
</fieldset>
<label>Nombre de la persona<input name="name" required maxlength="120" autocomplete="name" placeholder="Ej. J. M. Pitarque"/></label>
<label>Correo electrónico<input name="email" required type="email" maxlength="180" autocomplete="off" placeholder="j.m.pitarque@aliatgrup.com"/></label>
<fieldset><legend>Garden de destino</legend>
<label class="radio"><input type="radio" name="mode" value="existing" checked/> Garden existente</label>
<select id="garden" name="gardenId" aria-label="Garden existente" required><option value="">Seleccionar garden</option></select>
<label class="radio"><input type="radio" name="mode" value="new"/> Crear un garden nuevo</label>
<input id="newGarden" name="newGarden" class="hidden" placeholder="Nombre del nuevo garden" maxlength="120" disabled/>
</fieldset>
<label id="passwordLabel" class="hidden">Contraseña inicial
<span class="passwordField"><input type="password" id="initialPassword" name="password" autocomplete="new-password" minlength="8" maxlength="128" placeholder="Mínimo 8 caracteres" disabled/><button type="button" id="toggleInitialPassword" class="passwordToggle" aria-label="Mostrar contraseña" aria-pressed="false" title="Mostrar contraseña">Mostrar</button></span>
<span class="hint">No se enviará ningún correo. Comunica las credenciales por un canal privado y pide cambiar la contraseña en el primer acceso.</span></label>
<button type="submit" id="submitAccount">Enviar invitación →</button><span class="hint">Solo el administrador puede acceder a esta función. La contraseña y el correo se gestionan en Supabase.</span>
</form>
<section id="pendingSection" class="hidden" aria-labelledby="pendingTitle">
<hr style="border:0;border-top:1px solid #dce9df;margin:32px 0 26px"/>
<span class="eyebrow">ACCESOS PENDIENTES</span><h2 id="pendingTitle">Invitaciones sin activar</h2>
<p>Reenvía un enlace nuevo sin eliminar la cuenta ni cambiar el garden asignado.</p>
<div id="pendingList" class="pendingList"><p class="pendingEmpty">Cargando invitaciones…</p></div>
<p id="pendingFeedback" class="pendingFeedback" role="status" aria-live="polite"></p>
</section>
</section></main><WikiSupabase/>
<script>
const form=document.querySelector('#invite');
const status=document.querySelector('#status');
const garden=document.querySelector('#garden');
const newGarden=document.querySelector('#newGarden');
const passwordLabel=document.querySelector('#passwordLabel');
const initialPassword=document.querySelector('#initialPassword');
const toggleInitialPassword=document.querySelector('#toggleInitialPassword');
toggleInitialPassword.addEventListener('click',()=>{
 const visible=initialPassword.type==='password';
 initialPassword.type=visible?'text':'password';
 toggleInitialPassword.textContent=visible?'Ocultar':'Mostrar';
 toggleInitialPassword.setAttribute('aria-label',visible?'Ocultar contraseña':'Mostrar contraseña');
 toggleInitialPassword.setAttribute('aria-pressed',String(visible));
 toggleInitialPassword.title=visible?'Ocultar contraseña':'Mostrar contraseña';
});
const submitAccount=document.querySelector('#submitAccount');
const modeInputs=form.querySelectorAll('[name=mode]');
const pendingSection=document.querySelector('#pendingSection');
const pendingList=document.querySelector('#pendingList');
const pendingFeedback=document.querySelector('#pendingFeedback');
function renderPending(items){
 pendingList.replaceChildren();
 if(!items.length){
  const empty=document.createElement('p');empty.className='pendingEmpty';empty.textContent='No hay invitaciones pendientes.';pendingList.append(empty);return;
 }
 for(const item of items){
  const row=document.createElement('div');row.className='pendingRow';
  const info=document.createElement('div');
  const name=document.createElement('strong');name.textContent=item.name||item.email;
  const detail=document.createElement('small');detail.textContent=item.email+' · '+item.garden;
  const date=document.createElement('small');date.textContent='Invitado: '+new Date(item.invitedAt).toLocaleDateString('es-ES');
  info.append(name,detail,date);
  const button=document.createElement('button');button.type='button';button.textContent='Reenviar enlace';
  button.addEventListener('click',async()=>{
   if(!confirm('¿Enviar un nuevo enlace de activación a '+item.email+'?'))return;
   button.disabled=true;button.textContent='Enviando…';pendingFeedback.textContent='';
   try{
    const {data:{session}}=await window.wikiAuth.client.auth.getSession();
    if(!session)throw new Error('La sesión ha caducado. Vuelve a iniciar sesión.');
    const response=await fetch('/api/wiki-admin',{method:'POST',headers:{'Content-Type':'application/json',Authorization:'Bearer '+session.access_token},body:JSON.stringify({action:'resend',userId:item.id})});
    const result=await response.json();
    if(!response.ok)throw new Error(result.error||'No se pudo reenviar.');
    pendingFeedback.textContent='Enlace nuevo enviado a '+result.email+'.';
    button.textContent='Reenviado';
   }catch(error){pendingFeedback.textContent=error.message||'No se pudo reenviar.';button.textContent='Reenviar enlace';button.disabled=false}
  });
  row.append(info,button);pendingList.append(row);
 }
}
function updatePending(payload){
 if(payload.pending){renderPending(payload.pending);pendingSection.classList.remove('hidden')}
}

const showStatus=(message,error=false,success=false)=>{status.textContent=message;status.toggleAttribute('data-error',error);status.toggleAttribute('data-success',success)};
function updateMode(){
 const isNew=form.elements.mode.value==='new';
 garden.disabled=isNew;garden.required=!isNew;garden.classList.toggle('hidden',isNew);
 newGarden.disabled=!isNew;newGarden.required=isNew;newGarden.classList.toggle('hidden',!isNew);
}
modeInputs.forEach(input=>input.addEventListener('change',updateMode));
function updateAccountMode(){
 const direct=form.elements.accountMode.value==='direct';
 passwordLabel.classList.toggle('hidden',!direct);
 initialPassword.disabled=!direct;initialPassword.required=direct;
 submitAccount.textContent=direct?'Crear cuenta sin enviar email →':'Enviar invitación →';
}
form.querySelectorAll('[name=accountMode]').forEach(input=>input.addEventListener('change',updateAccountMode));

let token='';
async function boot(){
 try{
  if(!window.wikiAuth){showStatus('No se ha cargado la autenticación. Actualiza la página.',true);return;}
  await window.wikiAuth.ready;
  const {data,error}=await window.wikiAuth.client.auth.getSession();
  if(error||!data.session){location.replace('/acceso/?next=/administracion/');return;}
  token=data.session.access_token;
  const response=await fetch('/api/wiki-admin',{headers:{Authorization:'Bearer '+token}});
  const payload=await response.json();
  if(!response.ok)throw Error(payload.error||'No tienes permiso para administrar WikiGarden.');
  garden.replaceChildren(new Option('Seleccionar garden',''),...payload.gardens.map(g=>new Option(g.name,g.id)));
  showStatus('Selecciona el garden e introduce los datos del nuevo usuario.');
  form.classList.remove('hidden');
  updatePending(payload);
 }catch(error){showStatus(error.message||'No se pudo cargar el panel.',true)}
}
form.addEventListener('submit',async event=>{
 event.preventDefault();if(!form.reportValidity())return;
 const submit=form.querySelector('button[type=submit]');submit.disabled=true;
 showStatus(form.elements.accountMode.value==='direct'?'Creando cuenta sin enviar emails…':'Enviando invitación…');
 const data=new FormData(form),isNew=data.get('mode')==='new';
 try{
  const {data:session}=await window.wikiAuth.client.auth.getSession();
  const response=await fetch('/api/wiki-admin',{
   method:'POST',headers:{'Content-Type':'application/json',Authorization:'Bearer '+session.session.access_token},
   body:JSON.stringify({name:data.get('name'),email:data.get('email'),gardenId:isNew?'':data.get('gardenId'),newGarden:isNew?data.get('newGarden'):'',accountMode:data.get('accountMode'),password:data.get('accountMode')==='direct'?data.get('password'):''})
  });
  const result=await response.json();
  if(!response.ok)throw Error(result.error||'No se pudo enviar la invitación.');
  showStatus((result.accountMode==='direct'?'Cuenta creada sin enviar email: ':'Invitación enviada a ')+result.email+' · Garden: '+result.garden+'.',false,true);
  form.reset();initialPassword.type='password';toggleInitialPassword.textContent='Mostrar';toggleInitialPassword.setAttribute('aria-label','Mostrar contraseña');toggleInitialPassword.setAttribute('aria-pressed','false');toggleInitialPassword.title='Mostrar contraseña';updateMode();updateAccountMode();
  const list=await fetch('/api/wiki-admin',{headers:{Authorization:'Bearer '+session.session.access_token}}).then(r=>r.json());
  if(list.ok){garden.replaceChildren(new Option('Seleccionar garden',''),...list.gardens.map(g=>new Option(g.name,g.id)));updatePending(list)}
 }catch(error){showStatus(error.message||'Error al enviar.',true)}
 finally{submit.disabled=false}
});
document.addEventListener('wikigarden:auth-initialized',boot,{once:true});
if(window.wikiAuth)boot();
</script>
</body></html>
const groups=[
 {id:'localizacion',name:'Localización',icon:'⌖',href:'/problemas/localizacion/',description:'Encuentra lo que tienes y evita ventas perdidas.',questions:['¿Algún cliente se ha ido sin un producto que el sistema decía que teníais?','¿Hay zonas del almacén sin un nombre o código que todo el equipo use igual?','¿Habéis encontrado mercancía "olvidada" al reorganizar o limpiar?']},
 {id:'sobrestock',name:'Sobrestock',icon:'▦',href:'/problemas/sobrestock/',description:'Libera capital y espacio de referencias que no rotan.',questions:['¿Tienes producto que lleva más de una temporada sin venderse?','¿Has tenido que liquidar o tirar planta por exceso de compra?','¿El almacén está lleno pero aun así faltan referencias en tienda?']},
 {id:'compras',name:'Compras',icon:'↗',href:'/problemas/compras/',description:'Planifica pedidos apoyándote en datos.',questions:['¿Haces el pedido semanal sobre todo "a ojo", recorriendo el garden?','¿Preparar el pedido semanal te lleva más de dos horas?','¿Las compras de campaña se basan solo en lo que se compró el año pasado?']},
 {id:'conteos',name:'Conteos',icon:'✓',href:'/problemas/conteos/',description:'Trabaja con un inventario que refleje la realidad.',questions:['¿Hacéis inventario completo una vez al año o con menor frecuencia?','¿Tras el inventario hay diferencias grandes que nadie sabe explicar?','¿Se producen roturas, mermas o pérdidas de plantas que quedan sin registrar en el sistema?']}
];
---
<section class="diagnosticApp" id="diagnosticApp">
 <div class="diagnosticIntro"><span class="eyebrow">WIKIGARDEN · AUTODIAGNÓSTICO</span><h2>Descubre qué necesita tu garden.</h2><p>Piensa en las últimas cuatro semanas. Cada respuesta «Sí» suma un punto al problema correspondiente. Son 12 preguntas y unos 5 minutos.</p><div class="progressTop"><strong id="progressLabel">0 de 12 respondidas</strong><span id="progressPercent">0%</span></div><div class="progress"><div id="progressFill"></div></div></div>
 <form id="diagnosticForm">
 <div class="questionList" aria-label="Las 12 preguntas del autodiagnóstico">
 {groups.flatMap((group,g)=>group.questions.map((question,i)=>({group,question,index:g*3+i}))).map(({group,question,index})=>
 <div class="question" data-question={index} data-group={group.id} role="group" aria-labelledby={`question-label-${index}`}>
   <div class="questionPrompt" id={`question-label-${index}`}><span class="questionNumber">{String(index+1).padStart(2,'0')}</span><span>{question}</span></div>
   <div class="choices" aria-label="Respuesta">
     <label><input type="radio" name={`q${index}`} value="yes" /><span>Sí</span></label>
     <label><input type="radio" name={`q${index}`} value="no" /><span>No</span></label>
   </div>
 </div>)}
 </div>
 <div class="formBottom"><p id="validation" role="alert" aria-live="polite"></p><button id="diagnose" type="submit">Dame el diagnóstico <span aria-hidden="true">↗</span></button><span>Responde las 12 preguntas para calcular tus prioridades.</span></div>
 </form>
 <section id="results" class="results" hidden aria-live="polite" tabindex="-1"><div class="resultsIntro"><span class="eyebrow">TU DIAGNÓSTICO</span><h2>Tu hoja de ruta empieza aquí.</h2><p>Resultados basados en tus respuestas. Cuanto más alta la puntuación, mayor atención merece ese problema.</p></div><div class="scoreGrid" id="scoreGrid">
 {groups.map(group=><article class="scoreCard" data-score-group={group.id}>
   <div class="scoreHead"><span class="scoreIcon" aria-hidden="true">✓</span><span class="priority low">Bajo control</span></div>
   <h3>{group.name}</h3>
   <div class="scoreValue"><strong>0</strong><span>/ 3 puntos</span></div>
   <div class="scoreTrack"><div style="width:0%"></div></div>
   <p>{group.description}</p><a href={group.href}>Ver soluciones ↗</a>
 </article>)}
 </div><div class="recommendation" id="recommendation"></div><div class="resultActions"><button type="button" id="redo">Modificar respuestas ↺</button><a href="/diagnostico/">Solicitar diagnóstico gratuito ↗</a></div><p class="disclaimer">Esta herramienta es orientativa, no una auditoría de inventario. Si varios problemas alcanzan 3 puntos, prioriza los conteos como base para trabajar con datos fiables.</p></section>
</section>
<script>
function initDiagnostic(){
 const root=document.getElementById('diagnosticApp');if(!root||root.dataset.initialized)return;root.dataset.initialized='true';
 const groups=[{id:'localizacion',name:'Localización',icon:'⌖',href:'/problemas/localizacion/',desc:'Encuentra lo que tienes y evita ventas perdidas.'},{id:'sobrestock',name:'Sobrestock',icon:'▦',href:'/problemas/sobrestock/',desc:'Libera capital y espacio de referencias que no rotan.'},{id:'compras',name:'Compras',icon:'↗',href:'/problemas/compras/',desc:'Planifica pedidos apoyándote en datos.'},{id:'conteos',name:'Conteos',icon:'✓',href:'/problemas/conteos/',desc:'Trabaja con un inventario que refleje la realidad.'}];
 const form=root.querySelector('#diagnosticForm'),result=root.querySelector('#results'),grid=root.querySelector('#scoreGrid'),recommend=root.querySelector('#recommendation'),validation=root.querySelector('#validation');
 const update=()=>{let answered=0;root.querySelectorAll('.question').forEach(field=>{let checked=field.querySelector('input:checked');field.classList.toggle('answered',!!checked);if(checked)answered++});root.querySelector('#progressLabel').textContent=answered+' de 12 respondidas';root.querySelector('#progressPercent').textContent=Math.round(answered/12*100)+'%';root.querySelector('#progressFill').style.width=(answered/12*100)+'%';validation.textContent='';};form.addEventListener('change',update);
 form.addEventListener('submit',ev=>{ev.preventDefault();const fields=[...root.querySelectorAll('.question')];const missing=fields.find(f=>!f.querySelector('input:checked'));if(missing){validation.textContent='Faltan '+fields.filter(f=>!f.querySelector('input:checked')).length+' preguntas por responder.';missing.scrollIntoView({behavior:'smooth',block:'center'});missing.querySelector('input').focus();return;}
 const scores=groups.map((group,i)=>({...group,score:fields.slice(i*3,i*3+3).filter(f=>f.querySelector('input:checked')?.value==='yes').length}));const max=Math.max(...scores.map(x=>x.score));const tied=scores.filter(x=>x.score===3).length>=2;const sorted=[...scores].sort((a,b)=>b.score-a.score||(a.id==='conteos'?-1:b.id==='conteos'?1:0));
 for(const [rank,group] of sorted.entries()){const card=grid.querySelector('[data-score-group="'+group.id+'"]');if(!card)continue;card.style.order=String(rank);const level=group.score===3?'Prioridad alta':group.score===2?'Requiere atención':'Bajo control';const cls=group.score===3?'high':group.score===2?'medium':'low';card.querySelector('.priority').className='priority '+cls;card.querySelector('.priority').textContent=level;card.querySelector('.scoreIcon').textContent=group.score===3?'!':group.score===2?'⚠':'✓';card.querySelector('.scoreIcon').className='scoreIcon '+cls;card.querySelector('.scoreValue strong').textContent=group.score;card.querySelector('.scoreTrack div').style.width=(group.score/3*100)+'%';}
 recommend.replaceChildren();
 const explanations={
 localizacion:{impact:'Un producto que existe pero no se encuentra puede provocar ventas perdidas, compras duplicadas y tiempo desperdiciado buscando mercancía.',why:'Empieza por codificar las zonas, asignar ubicaciones a cada familia y señalizar los espacios. Es una intervención visible y sencilla que también facilita los futuros conteos.'},
 sobrestock:{impact:'El exceso de existencias inmoviliza dinero, ocupa espacio y aumenta el riesgo de merma, especialmente en planta viva.',why:'Empieza identificando referencias con poca rotación y calculando su cobertura. Así podrás priorizar devoluciones, traspasos y ajustes de compra sin liquidar todo indiscriminadamente.'},
 compras:{impact:'Comprar sin apoyarse en ventas y plazos puede causar tanto roturas de stock como exceso de mercancía, además de consumir horas de planificación.',why:'Empieza revisando ventas históricas, plazos de reposición y puntos de pedido de las referencias más importantes. Necesitarás comprobar primero que los datos de existencias sean razonablemente fiables.'},
 conteos:{impact:'Si el stock registrado no coincide con el real, puedes perder ventas por stock fantasma y tomar decisiones de compra sobre cifras equivocadas.',why:'Empieza por conteos cíclicos por zonas, recuento de discrepancias y registro diario de mermas. Una base de stock fiable mejora la localización, las compras y la detección de sobrestock.'}
 };
 const label=document.createElement('span');label.className='eyebrow';label.textContent='POR DÓNDE EMPEZAR';
 const title=document.createElement('h3');const detail=document.createElement('p');const why=document.createElement('p');const link=document.createElement('a');
 if(max===0){title.textContent='Mantén el control y sigue comprobando tus datos.';detail.textContent='No has marcado señales de alerta en estas doce preguntas. Eso es positivo, pero no equivale a una auditoría: podrían existir desviaciones no detectadas.';why.textContent='Siguiente paso: programa verificaciones periódicas del stock y revisa indicadores de mermas y roturas para mantener esa situación.';link.textContent='Revisar las buenas prácticas de conteo ↗';link.href='/problemas/conteos/';}
 else {const first=tied?scores.find(x=>x.id==='conteos'):sorted[0];const rationale=explanations[first.id];title.textContent=tied?'Primero, asegura la fiabilidad del inventario.':'Tu primera prioridad: '+first.name+'.';detail.textContent=(tied?'Hay varias áreas con 3 de 3 señales. Antes de intervenir simultáneamente en todas, conviene disponer de un stock fiable. ':first.score===3?'Has identificado las 3 señales de este problema. ':first.score===2?'Has identificado 2 de las 3 señales de este problema. ':'Aunque las señales son limitadas, esta es una de las áreas que conviene vigilar. ')+rationale.impact;why.textContent='¿Por qué empezar aquí? '+rationale.why;link.textContent='Abrir la guía de '+first.name+' ↗';link.href=first.href;}
 recommend.append(label,title,detail,why,link);
 form.hidden=true;result.hidden=false;result.focus({preventScroll:true});result.scrollIntoView({behavior:'smooth',block:'start'});});
 root.querySelector('#redo').addEventListener('click',()=>{result.hidden=true;form.hidden=false;root.scrollIntoView({behavior:'smooth',block:'start'});});update();
}
initDiagnostic();document.addEventListener('astro:page-load',initDiagnostic);
</script>
<style>
.diagnosticApp{font-family:'Outfit',system-ui,sans-serif;color:#22352f;max-width:1180px;margin:0 auto}.diagnosticApp *{box-sizing:border-box}.eyebrow{font-size:11px;color:#409888;font-weight:800;letter-spacing:.13em}.diagnosticIntro{padding:26px 0 20px}.diagnosticIntro h2,.resultsIntro h2{font-size:clamp(30px,4vw,46px);letter-spacing:-.055em;line-height:1.13;margin:10px 0}.diagnosticIntro>p,.resultsIntro>p{color:#70817b;font-size:15px;line-height:1.7;max-width:720px}.progressTop{display:flex;justify-content:space-between;margin-top:22px;color:#2f7567;font-size:12px}.progress{background:#e4efea;height:9px;border-radius:50px;overflow:hidden;margin-top:9px}.progress>div{height:100%;width:0%;background:#45968a;border-radius:50px;transition:width .25s}.questionList{background:#fff;border:1px solid #dfeae5;border-radius:20px;padding:10px 26px;box-shadow:0 8px 25px #1b49390a}.question{padding:20px 0;border:0;border-bottom:1px solid #ecf0ed;margin:0;display:grid;grid-template-columns:minmax(0,1fr) 192px;gap:22px;align-items:center;min-height:100px}.question:last-child{border-bottom:0}.questionPrompt{display:flex;align-items:baseline;gap:14px;font-size:15px;font-weight:600;line-height:1.5;min-width:0}.questionNumber{flex:none;font-size:12px;color:#76a79a;font-weight:800}.choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;width:192px;align-items:stretch;margin:0}.choices label{display:block;position:relative;cursor:pointer;margin:0!important;min-width:0}.choices input{position:absolute;opacity:0;width:1px;height:1px}.choices span{display:flex;justify-content:center;align-items:center;min-height:43px;width:100%;border:1px solid #dce9e3;border-radius:30px;padding:9px 12px;font-size:14px;color:#638075;font-weight:700;background:#f8faf9;transition:background-color .15s,border-color .15s}.choices input:checked+span{background:#45968a;border-color:#45968a;color:#fff}.choices input:focus-visible+span{outline:2px solid #276e60;outline-offset:2px}.question.answered .questionNumber{color:#318f76}
.formBottom{display:flex;flex-wrap:wrap;align-items:center;gap:15px;padding:25px 0 40px}.formBottom button,.resultActions a{border:0;background:#45968a;color:#fff!important;padding:15px 26px;border-radius:30px;font-size:14px;font-weight:800;cursor:pointer;text-decoration:none!important}.formBottom button:hover,.resultActions a:hover{background:#2c796b}.formBottom>span{font-size:12px;color:#798b83}.formBottom #validation{width:100%;font-size:13px;color:#bc5b36;font-weight:600;margin:0}.results[hidden],#diagnosticForm[hidden]{display:none!important}.results{padding:30px 0}.scoreGrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));align-items:stretch;gap:16px;margin:26px 0}.scoreCard{box-sizing:border-box;background:#fff;border:1px solid #dce7e2;border-radius:18px;padding:20px;display:grid;grid-template-rows:48px minmax(58px,auto) 60px 12px minmax(90px,1fr) 30px;gap:10px;min-width:0;height:100%;box-shadow:0 8px 25px #24543e10}.scoreHead{display:flex;align-items:center;justify-content:space-between;gap:8px;min-width:0}.scoreIcon{display:grid;place-items:center;font-size:18px;font-weight:800;width:38px;height:38px;border-radius:11px;background:#e6f2ed;color:#287d64}.scoreIcon.high{color:#a14b39;background:#faeae0}.scoreIcon.medium{color:#947021;background:#f9f1d9}.priority{display:inline-flex;align-items:center;justify-content:center;font-size:10px;line-height:1.2;padding:7px 9px;border-radius:22px;font-weight:800;text-align:center}.priority.high{color:#9b5438;background:#faeae0}.priority.medium{color:#9a752a;background:#f9f1d9}.priority.low{color:#287d64;background:#e0f2e8}.scoreCard h3{font-size:20px;line-height:1.25;margin:0;align-self:center}.scoreValue{display:flex;align-items:baseline;gap:6px;align-self:center}.scoreValue strong{font-size:44px;color:#276a60;letter-spacing:-.07em;line-height:1}.scoreValue span{font-size:12px;color:#82968c}.scoreTrack{height:10px;border-radius:50px;background:#e6efea;overflow:hidden;margin:0;align-self:center}.scoreTrack div{height:100%;background:#45968a;border-radius:50px}.scoreCard p{font-size:12px;line-height:1.55;color:#6f8278;margin:0;align-self:start}.scoreCard a{font-size:12px;font-weight:700;color:#277d69;text-decoration:none;align-self:end}
.recommendation{background:#e7f3ed;border:1px solid #d3e7db;border-radius:20px;padding:28px}.recommendation h3{font-size:clamp(20px,3vw,29px);letter-spacing:-.04em;margin:9px 0}.recommendation p{color:#4e6f60;max-width:830px;line-height:1.7;margin:12px 0}.recommendation p+p{padding-top:12px;border-top:1px solid #cce3d5}.recommendation a{color:#257a66;font-weight:800;text-decoration:none}.resultActions{display:flex;align-items:center;flex-wrap:wrap;gap:14px;margin:24px 0}.resultActions button{border:1px solid #b9d8cb;background:white;border-radius:30px;padding:13px 20px;cursor:pointer;font:700 13px 'Outfit',sans-serif;color:#236b5b}.disclaimer{font-size:12px;color:#83958c;line-height:1.55}
@media(max-width:1000px){.scoreGrid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:650px){.questionList{padding:4px 16px}.question{grid-template-columns:1fr;gap:12px;padding:17px 0;min-height:0}.questionPrompt{font-size:14px;gap:10px}.choices{width:100%;max-width:240px;margin-left:24px}.scoreGrid{grid-template-columns:1fr}.diagnosticIntro{padding-top:8px}}
</style>

<form class="contactForm" id="garden-contact-form">
 <div class="contactTrap" aria-hidden="true"><label>No rellenar <input name="website" tabindex="-1" autocomplete="off"/></label></div>
 <div class="formRow"><label>Nombre del garden <input name="garden" required autocomplete="organization" placeholder="Ej. Garden Central" maxlength="120"/></label><label>Email de contacto <input name="email" type="email" required autocomplete="email" placeholder="tu@garden.es" maxlength="180"/></label></div>
 <fieldset><legend>¿Qué problemas quieres resolver? <small>Elige uno o varios.</small></legend>
  <div class="options"><label><input type="checkbox" name="problema" value="Stock mal localizado"/><span>📍 Localización</span></label><label><input type="checkbox" name="problema" value="Sobrestock"/><span>📦 Sobrestock</span></label><label><input type="checkbox" name="problema" value="Planificación de compras"/><span>📊 Compras</span></label><label><input type="checkbox" name="problema" value="Conteos poco fiables"/><span>✅ Conteos</span></label><label><input type="checkbox" name="problema" value="Entradas y salidas de mercancía"/><span>↔️ Entradas y salidas</span></label></div>
 </fieldset>
 <label>Cuéntanos un poco más <textarea name="detalle" rows="5" maxlength="3000" placeholder="¿Qué ocurre en tu garden? ¿Qué te gustaría mejorar?"></textarea></label>
 <p class="disclaimer">Enviaremos tu solicitud directamente al equipo de Cymara. Tus datos se utilizarán para responder a esta consulta.</p>
 <button type="submit">Enviar solicitud →</button><p id="contact-status" role="status" aria-live="polite"></p>
</form>
<script>
function initGardenContact(){
 document.querySelectorAll('.contactForm').forEach(form=>{
  if(form.dataset.ready)return;
  form.dataset.ready='1';
  const status=form.querySelector('[role="status"]');
  const button=form.querySelector('[type="submit"]');
  form.addEventListener('submit',async event=>{
   event.preventDefault();
   if(!form.reportValidity())return;
   const data=new FormData(form);
   const problemas=data.getAll('problema');
   if(!problemas.length){status.textContent='Selecciona al menos un problema.';return;}
   button.disabled=true;
   button.textContent='Enviando…';
   status.textContent='Estamos enviando tu solicitud.';
   try{
    const response=await fetch('/api/contact',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
     garden:data.get('garden'),email:data.get('email'),problemas,detalle:data.get('detalle'),website:data.get('website'),
     source:window.location.pathname
    })});
    const result=await response.json();
    if(!response.ok||!result.ok)throw new Error(result.error||'No se pudo enviar la solicitud.');
    form.reset();
    status.textContent='Solicitud enviada correctamente. El equipo de Cymara la ha recibido para su seguimiento.';
   }catch(error){
    status.textContent=(error instanceof Error?error.message:'Error de conexión.')+' También puedes escribir directamente a info@cymara.es.';
   }finally{button.disabled=false;button.textContent='Enviar solicitud →';}
  });
 });
}
initGardenContact();document.addEventListener('astro:page-load',initGardenContact);
</script>
<style>
.contactTrap{position:absolute!important;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.contactForm button:disabled{opacity:.65;cursor:wait}.contactForm{border:1px solid #e0eae5;border-radius:17px;padding:24px;background:#f8faf9;display:grid;gap:18px;min-width:0;font-family:'Outfit',sans-serif}.contactForm label{font-size:13px;font-weight:700;color:#34554b;display:grid;gap:8px}.formRow{display:grid;grid-template-columns:1fr 1fr;gap:14px}.contactForm input:not([type=checkbox]),.contactForm textarea{width:100%;border:1px solid #d5e5dc;background:#fff;border-radius:10px;padding:12px;font:400 14px 'Outfit',sans-serif;color:#1f3630}.contactForm input:focus,.contactForm textarea:focus{outline:2px solid #45968a;outline-offset:1px}.contactForm fieldset{padding:0;border:0;min-width:0}.contactForm legend{color:#34554b;font-size:13px;font-weight:700;margin-bottom:12px}.contactForm legend small{font-weight:400;color:#81958b}.options{display:grid;grid-template-columns:1fr 1fr;gap:9px}.options label{display:block;cursor:pointer}.options label input{position:absolute;opacity:0;pointer-events:none}.options label span{display:block;border:1px solid #dbe8e0;background:#fff;border-radius:10px;padding:12px 10px;font-size:13px;transition:.15s}.options label input:checked+span{border-color:#45968a;background:#e2f2ea;color:#206957}.options label input:focus-visible+span{outline:2px solid #45968a}.contactForm button{border:0;border-radius:25px;background:#45968a;color:#fff;font:700 14px 'Outfit',sans-serif;padding:13px 20px;cursor:pointer}.contactForm button:hover{background:#2f7a6f}.disclaimer{font-size:11px!important;color:#75897e;line-height:1.45;margin:0!important}#contact-status{margin:0;color:#296f5d;font-size:12px}@media(max-width:590px){.formRow,.options{grid-template-columns:1fr}.contactForm{padding:16px}}
</style>
<style>
/* Problemas: tarjetas uniformes y texto perfectamente alineado */
.contactForm .options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;align-items:stretch}
.contactForm .options label{height:100%;min-width:0;display:block;margin:0}
.contactForm .options label span{display:flex;align-items:center;min-height:57px;height:100%;padding:12px 14px;line-height:1.35}
@media(max-width:590px){.contactForm .options{grid-template-columns:1fr}}
</style>

---
const { kind = 'localizacion' } = Astro.props;
const flows = {
localizacion: { title:'Del producto perdido al producto localizado', steps:[['01','Codifica','Define zonas y pasillos'],['02','Señaliza','Haz visible cada ubicación'],['03','Asigna','Da una zona a cada familia'],['04','Controla','Revisa al cambiar de temporada']] },
sobrestock:{title:'Del almacén saturado a la compra optimizada',steps:[['01','Mide','Calcula semanas de cobertura'],['02','Clasifica','Prioriza referencias ABC'],['03','Actúa','Traspasa, devuelve o liquida'],['04','Previene','Ajusta la próxima compra']]},
compras:{title:'De comprar a ojo a decidir con datos',steps:[['01','Analiza','Revisa ventas y estacionalidad'],['02','Calcula','Define punto de pedido'],['03','Planifica','Agrupa por proveedor'],['04','Ajusta','Revisa excepciones y campaña']]},
movimientos:{title:'Del albarán a un stock siempre actualizado',steps:[['01','Comprueba','Verifica albarán y mercancía'],['02','Identifica','Etiqueta cada referencia'],['03','Registra','Vincula ventas y movimientos'],['04','Concilia','Revisa excepciones cada día']]},
conteos:{title:'De diferencias inexplicables a stock fiable',steps:[['01','Organiza','Divide en zonas y frecuencias'],['02','Cuenta','Sin ver el dato del sistema'],['03','Investiga','Recuenta diferencias'],['04','Corrige','Registra causas y mermas']]}
};
const flow=flows[kind] || flows.localizacion;
---
<section class="actionFlow" aria-label={flow.title}><div class="flowtop"><span>PROCESO VISUAL</span><h3>{flow.title}</h3></div><div class="steps">{flow.steps.map(([n,t,d])=><div class="step"><span class="number">{n}</span><span class="stepTitle">{t}</span><span class="stepDescription">{d}</span></div>)}</div><a href="/laboratorio/" class="try">Prueba nuestras herramientas interactivas ↗</a></section>
<style>
.actionFlow{font-family:'Outfit',system-ui,sans-serif;background:#eaf4f1;border:1px solid #d5e8df;border-radius:20px;padding:22px;margin:25px 0 30px}.flowtop>span{color:#39917c;font-size:10px;font-weight:800;letter-spacing:.13em}.flowtop h3{font-size:20px;letter-spacing:-.03em;margin:7px 0 22px;color:#1e4b40}.steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;align-items:stretch}.steps>.step{margin-block:0!important;margin-top:0!important;height:100%;box-sizing:border-box}.steps>.step:nth-child(n){transform:none}.step{position:relative;display:flex;flex-direction:column;margin:0!important;align-self:stretch;background:#fff;border:1px solid #dbe9e2;border-radius:13px;padding:17px 13px;gap:6px;min-width:0}.step:not(:last-child):after{content:'→';position:absolute;right:-14px;top:38%;font-weight:900;font-size:20px;color:#2f8e7a;z-index:2}.number{width:35px;height:35px;border-radius:9px;display:grid;place-items:center;background:#eaf4f1;font-weight:800;color:#30836f;font-size:13px}.stepTitle{font-weight:800;color:#2c4940;font-size:16px}.stepDescription{color:#6a7d73;font-size:12px;line-height:1.4}.try{display:inline-block;margin-top:19px;color:#217762!important;font-size:13px;font-weight:700;text-decoration:none!important}@media(max-width:700px){.steps{grid-template-columns:repeat(2,minmax(0,1fr))}.step:nth-child(2):after{display:none}}@media(max-width:430px){.steps{grid-template-columns:1fr}.step:after{display:none}}
</style>
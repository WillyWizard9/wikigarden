---
const { kind = 'localizacion' } = Astro.props;
const stepSets = {
 localizacion: ['Comprender el problema','Crear el mapa de ubicaciones','Organizar y controlar','Implantar y medir','Revisar y completar'],
 sobrestock: ['Detectar el exceso','Medir y clasificar','Decidir acciones','Prevenir y medir','Completar el plan'],
 compras: ['Entender las compras','Calcular la reposición','Planificar por familias','Implantar y medir','Revisar el plan'],
 conteos: ['Detectar las diferencias','Preparar y contar','Investigar y organizar','Implantar y medir','Completar el conteo'],
 movimientos: ['Identificar las fugas','Controlar recepciones','Registrar ventas y movimientos','Implantar y medir','Completar el control']
};
const steps = stepSets[kind] || [
  'Comprender el problema',
  'Crear el mapa de ubicaciones',
  'Organizar y controlar',
  'Implantar y medir',
  'Revisar y completar'
];
---
<section class="guideJourney" data-guide-journey data-kind={kind} aria-label="Recorrido de aprendizaje de Localización">
 <div class="journeyTop">
  <div><span class="journeyKicker">TU RECORRIDO · {kind.toUpperCase()}</span><h2>De la teoría a la práctica, paso a paso</h2><p>Todo el contenido original, organizado en cinco etapas. Puedes avanzar libremente y marcar las etapas completadas.</p></div>
  <span class="journeyCounter" data-counter>0 de 5 completados</span>
 </div>
 <div class="journeyTrack" role="progressbar" aria-valuemin="0" aria-valuemax="5" aria-valuenow="0" aria-label="Pasos completados" data-track><div data-fill></div></div>
 <nav class="journeySteps" aria-label="Pasos de la guía">
  {steps.map((label,i)=><button class="journeyStep" type="button" data-go={i} aria-current={i===0?'step':undefined}><span class="journeyNumber">{i+1}</span><span>{label}</span></button>)}
 </nav>
 <div class="journeyActions">
  <button type="button" data-prev>← Paso anterior</button>
  <label class="journeyDone"><input type="checkbox" data-done /> <span>He completado este paso</span></label>
  <button type="button" data-next>Siguiente paso →</button>
 </div>
</section>
<script is:inline>
(function(){
  function initJourney(){
    const root=document.querySelector('[data-guide-journey]');
    if(!root || root.dataset.ready==='1')return;
    const kind=root.dataset.kind || 'localizacion';
    const panels=[...document.querySelectorAll('[data-journey-panel]')].filter(el=>el.dataset.journeyPanel!==undefined);
    if(panels.length!==5)return;
    const tabs=[...root.querySelectorAll('[data-go]')];
    const previous=root.querySelector('[data-prev]');
    const next=root.querySelector('[data-next]');
    const checkbox=root.querySelector('[data-done]');
    if(tabs.length!==5 || !previous || !next || !checkbox)return;
    root.dataset.ready='1';
    const storageKey='wikigarden:'+kind+':steps:v3';
    let completed=[false,false,false,false,false];
    try{
      const stored=JSON.parse(localStorage.getItem(storageKey)||'null');
      if(Array.isArray(stored)&&stored.length===5)completed=stored.map(Boolean);
    }catch(e){}
    let active=0;
    function show(shouldScroll){
      panels.forEach((panel,i)=>{panel.hidden=i!==active;});
      tabs.forEach((tab,i)=>{
        tab.classList.toggle('active',i===active);
        tab.classList.toggle('completed',completed[i]);
        tab.setAttribute('aria-pressed',String(i===active));
        tab.querySelector('.journeyNumber').textContent=completed[i]?'✓':String(i+1);
      });
      checkbox.checked=completed[active];
      const count=completed.filter(Boolean).length;
      root.querySelector('[data-counter]').textContent=count+' de 5 completados';
      root.querySelector('[data-fill]').style.width=(count*20)+'%';
      root.querySelector('[data-track]').setAttribute('aria-valuenow',String(count));
      previous.disabled=active===0;
      next.textContent=active===4?'Volver al inicio ↻':'Siguiente paso →';
      if(shouldScroll)root.scrollIntoView({behavior:'smooth',block:'start'});
    }
    tabs.forEach((tab,i)=>tab.addEventListener('click',()=>{active=i;show(true)}));
    previous.addEventListener('click',()=>{active=Math.max(0,active-1);show(true)});
    next.addEventListener('click',()=>{active=(active+1)%5;show(true)});
    checkbox.addEventListener('change',()=>{
      completed[active]=checkbox.checked;
      try{localStorage.setItem(storageKey,JSON.stringify(completed));}catch(e){}
      show(false);
    });
    show(false);
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initJourney,{once:true});
  else initJourney();
  document.addEventListener('astro:page-load',initJourney);
})();
</script>
<style is:global>
.guideJourney{margin:28px 0 20px;padding:clamp(18px,3vw,28px);background:#edf7f1;border:1px solid #d5e8dc;border-radius:20px;font-family:Outfit,system-ui,sans-serif;color:#254e40;scroll-margin-top:90px}
.guideJourney .journeyKicker{font-size:10px;letter-spacing:.11em;font-weight:800;color:#368874}
.guideJourney .journeyTop{display:flex;justify-content:space-between;gap:18px;align-items:flex-start}
.guideJourney .journeyTop h2{font-size:clamp(20px,2.8vw,28px);margin:8px 0;line-height:1.2}
.guideJourney .journeyTop p{font-size:13px;color:#627e70;line-height:1.6;margin:0;max-width:640px}
.guideJourney .journeyCounter{white-space:nowrap;font-size:12px;font-weight:800;color:#327963;background:white;border-radius:25px;padding:8px 12px}
.guideJourney .journeyTrack{height:10px;background:#d5e9dd;overflow:hidden;border-radius:20px;margin:20px 0}
.guideJourney .journeyTrack>div{height:100%;width:0;background:#45968a;border-radius:20px;transition:width .25s}
.guideJourney .journeySteps{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}
.guideJourney .journeyStep{display:flex;flex-direction:column;align-items:flex-start;gap:9px;text-align:left;background:#fff;border:1px solid #dbeae2;border-radius:12px;padding:12px;min-width:0;min-height:97px;color:#567365;font:700 12px/1.4 Outfit,system-ui,sans-serif;cursor:pointer;margin:0!important}
.guideJourney .journeyStep.active{border-color:#45968a;box-shadow:0 0 0 1px #45968a;color:#245b4a}.guideJourney .journeyStep.completed .journeyNumber{background:#45968a;color:#fff}
.guideJourney .journeyNumber{width:26px;height:26px;background:#e4f2ea;color:#287c65;display:grid;place-items:center;border-radius:8px;font-weight:800}
.guideJourney .journeyActions{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:18px}
.guideJourney .journeyActions>button{background:#fff;border:1px solid #cce2d4;border-radius:24px;padding:10px 14px;color:#267662;font:700 12px Outfit,system-ui,sans-serif;cursor:pointer}
.guideJourney .journeyActions>button[data-next]{background:#348c75;color:#fff}.guideJourney .journeyActions>button:disabled{opacity:.35;cursor:not-allowed}
.guideJourney .journeyDone{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:700;color:#2e765e;cursor:pointer}.guideJourney .journeyDone input{accent-color:#348c75;width:18px;height:18px}
.journeyPanel[hidden]{display:none!important}.journeyPanel{margin:0 0 20px;min-width:0}.journeyPanel>:first-child{margin-top:0}
@media(max-width:800px){.guideJourney .journeySteps{grid-template-columns:repeat(2,minmax(0,1fr))}.guideJourney .journeyStep{min-height:75px}.guideJourney .journeyTop{flex-direction:column}.guideJourney .journeyActions{flex-wrap:wrap}.guideJourney .journeyDone{order:-1;width:100%;justify-content:center}}
@media(max-width:450px){.guideJourney .journeySteps{grid-template-columns:1fr 1fr}.guideJourney .journeyStep{padding:9px;font-size:11px}}
</style>
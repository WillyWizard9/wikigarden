---
const names=['Localización','Sobrestock','Compras','Conteos','Entradas y salidas'];
const keys=['localizacion','sobrestock','compras','conteos','movimientos'];
const icons=['⌖','▦','↗','✓','⇄'];
const stepLabels={
 localizacion:['Comprender el problema','Crear el mapa de ubicaciones','Organizar y controlar','Implantar y medir','Revisar y completar'],
 sobrestock:['Detectar el exceso','Medir y clasificar','Decidir acciones','Prevenir y medir','Completar el plan'],
 compras:['Entender las compras','Calcular la reposición','Planificar por familias','Implantar y medir','Revisar el plan'],
 conteos:['Detectar las diferencias','Preparar y contar','Investigar y organizar','Implantar y medir','Completar el conteo'],
 movimientos:['Identificar las fugas','Controlar recepciones','Registrar ventas y movimientos','Implantar y medir','Completar el control']
};
const stepIcons={
 localizacion:['🔍','🗺️','📍','🛠️','✅'],
 sobrestock:['📦','📊','🧮','♻️','📉'],
 compras:['🛒','🧾','🗓️','🚚','🎯'],
 conteos:['⚖️','📋','🔢','🔬','🏁'],
 movimientos:['🚪','📥','🏷️','🔄','🛡️']
};
const challengeIcons={localizacion:'🏵️',sobrestock:'💠',compras:'👑',conteos:'🎖️',movimientos:'🔰'};
---
<section class="profileApp" id="wg-profile">
 <div class="profileHero"><span class="profileEyebrow">MI ESPACIO · WIKIGARDEN</span><h2>Tu progreso tiene recompensa.</h2><p>Consulta los pasos completados y los logros que has conseguido en tu recorrido de aprendizaje.</p><div class="profileUser"><span>◉</span><strong id="profileName">Visitante</strong><span>Perfil de demostración</span></div></div>
 <div class="profileScore"><div><strong id="profileCount">0</strong><span>medallas desbloqueadas</span></div><div><strong id="profileCompleted">0</strong><span>retos completados</span></div><div><strong id="profilePct">0%</strong><span>avance total</span></div></div>
 <div class="medalIntro"><h2>Tu medallero</h2><p>Cada paso que completas desbloquea una medalla. Las pendientes permanecen en blanco y negro.</p></div>
 <div class="medalGroups">
 {keys.map((key,k)=><section class="medalGroup" data-group={key}><div class="medalGroupHeader"><div class="medalIcon">{icons[k]}</div><div><h3>{names[k]}</h3><span data-group-progress>0 de 5 pasos</span></div><a href={'/problemas/'+key+'/'}>{key==='movimientos'?'Ver reto':'Continuar'} →</a></div><div class="medalList">
 {stepLabels[key].map((label,i)=><div class="medal" data-medal={i} title={label}><span class="medalDisc"><span class="medalGlyph" aria-hidden="true">{stepIcons[key][i]}</span></span><strong>{label}</strong><small>Pendiente</small></div>)}
 <div class="medal challengeMedal" data-challenge-medal title={'Completar '+names[k]}><span class="medalDisc"><span class="medalGlyph" aria-hidden="true">{challengeIcons[key]}</span></span><strong>Reto completado</strong><small>5 de 5 pasos</small></div>
 </div></section>)}
 </div>
 <section class="milestoneSection">
  <div class="medalIntro"><h2>Logros especiales</h2><p>Descubre, practica y demuestra lo aprendido. Cada actividad desbloquea una medalla distinta.</p></div>
  <div class="specialGrid">
   <a href="/autodiagnostico/" class="specialAchievement" data-special="diagnostic"><span class="medalDisc"><span class="medalGlyph" aria-hidden="true">🩺</span></span><strong>Primer diagnóstico</strong><small>Completar las 25 preguntas</small><em data-status>Pendiente</em></a>
   <a href="/plantillas/" class="specialAchievement" data-special="downloads"><span class="medalDisc"><span class="medalGlyph" aria-hidden="true">📂</span></span><strong>Manos a la obra</strong><small data-download-caption>Descargar 3 plantillas distintas · 0/3</small><em data-status>Pendiente</em></a>
   <a href="/evaluacion/" class="specialAchievement" data-special="exam-done"><span class="medalDisc"><span class="medalGlyph" aria-hidden="true">📝</span></span><strong>Conocimientos a prueba</strong><small>Realizar el test de 15 preguntas</small><em data-status>Pendiente</em></a>
   <a href="/evaluacion/" class="specialAchievement" data-special="exam-passed"><span class="medalDisc"><span class="medalGlyph" aria-hidden="true">🎓</span></span><strong>Experto en inventario</strong><small>Aprobar con al menos 12/15</small><em data-status>Pendiente</em></a>
  </div>
 </section>
 <section class="platinumSection" id="platinumAchievement">
  <div class="platinumTrophy" aria-hidden="true">🏆</div>
  <div><span class="profileEyebrow">LA DISTINCIÓN DEFINITIVA</span><h2>Trofeo Platino · Maestro del Garden</h2><p>Desbloquea los 25 pasos, las cinco medallas de reto completo y los cuatro logros especiales.</p><strong id="platinumStatus">Bloqueado · 0 de 34 logros</strong>
    <button type="button" id="replayPlatinum" hidden>Revivir la celebración ✨</button></div>
 </section>
 <button type="button" id="demoLogout">Salir de esta sesión</button><p class="profileDisclaimer">Los logros se guardan únicamente en este navegador. No hay sincronización entre dispositivos ni autenticación real.</p>
</section>
<script is:inline>
(function(){
 function init(){
  const root=document.getElementById('wg-profile');if(!root || root.dataset.initialized==='1')return;
  root.dataset.initialized='1';
  let user='Visitante';try{user=sessionStorage.getItem('wikigarden:demo-user')||user}catch(e){}
  root.querySelector('#profileName').textContent=user;
  function readJSON(key,fallback){try{return JSON.parse(localStorage.getItem(key)||'null')??fallback}catch(e){return fallback}}
  function refresh(){
   let stepCount=0,challengeCount=0;
   root.querySelectorAll('[data-group]').forEach(group=>{
    const saved=readJSON('wikigarden:'+group.dataset.group+':steps:v3',[]);
    const done=Array.from({length:5},(_,i)=>Array.isArray(saved)&&saved[i]===true);
    const count=done.filter(Boolean).length;
    stepCount+=count;
    if(count===5)challengeCount++;
    group.querySelector('[data-group-progress]').textContent=count+' de 5 pasos';
    group.querySelectorAll('[data-medal]').forEach((el,i)=>{
     el.classList.toggle('unlocked',done[i]);
     el.querySelector('small').textContent=done[i]?'Desbloqueada':'Pendiente';
    });
    const challenge=group.querySelector('[data-challenge-medal]');
    challenge.classList.toggle('unlocked',count===5);
    challenge.querySelector('small').textContent=count===5?'¡Reto superado!':count+' de 5 pasos';
   });
   const downloads=readJSON('wikigarden:downloaded-templates:v1',[]);
   const validDownloads=Array.isArray(downloads)?[...new Set(downloads.filter(x=>typeof x==='string'&&x.endsWith('.csv')))].length:0;
   const exam=readJSON('wikigarden:knowledge-exam:v1',null);
   const flags={
    diagnostic:!!localStorage.getItem('wikigarden:diagnostic-completed:v1'),
    downloads:validDownloads>=3,
    'exam-done':!!(exam&&(exam.completed===true||typeof exam.score==='number')),
    'exam-passed':!!exam?.passed
   };
   root.querySelector('[data-download-caption]').textContent='Descargar 3 plantillas distintas · '+Math.min(3,validDownloads)+'/3';
   root.querySelectorAll('[data-special]').forEach(el=>{
    const yes=!!flags[el.dataset.special];
    el.classList.toggle('unlocked',yes);
    el.querySelector('[data-status]').textContent=yes?'Desbloqueada':'Pendiente';
   });
   const extraCount=Object.values(flags).filter(Boolean).length;
   const earned=stepCount+challengeCount+extraCount;
   const platinum=earned===34;
   const trophy=root.querySelector('#platinumAchievement');
   trophy.classList.toggle('unlocked',platinum);
   trophy.querySelector('#platinumStatus').textContent=platinum?'¡Trofeo Platino desbloqueado!':earned+' de 34 logros para conseguir el platino';
   root.querySelector('#replayPlatinum').hidden=!platinum;
   root.querySelector('#profileCount').textContent=String(earned+(platinum?1:0));
   root.querySelector('#profileCompleted').textContent=String(challengeCount);
   root.querySelector('#profilePct').textContent=Math.round(earned/34*100)+'%';
  }
  refresh();
  document.addEventListener('wikigarden:achievement-progress',refresh);
  window.addEventListener('storage',refresh);
  root.querySelector('#replayPlatinum').addEventListener('click',()=>document.dispatchEvent(new CustomEvent('wikigarden:replay-platinum')));
  root.querySelector('#demoLogout').addEventListener('click',()=>{try{sessionStorage.removeItem('wikigarden:demo-user')}catch(e){}location.assign('/acceso/')});
 }
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});else init();
 document.addEventListener('astro:page-load',init);
})();
</script>
<style is:global>

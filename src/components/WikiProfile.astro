.profileScore{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:17px 0 30px}.profileScore>div{display:flex;flex-direction:column;gap:5px;padding:22px;border-radius:16px;background:white;border:1px solid #e0eae4}.profileScore strong{font-size:31px;color:#288263}.profileScore span{font-size:12px;color:#708a7a}.medalIntro h2{margin-bottom:5px}.medalIntro p{color:#738b80;margin-top:0}
.medalGroups{display:grid;gap:18px}.medalGroup{background:#fff;border:1px solid #e0e9e3;border-radius:18px;padding:20px}.medalGroupHeader{display:flex;align-items:center;gap:14px;margin-bottom:20px}.medalGroupHeader h3{font-size:19px;color:#265743;margin:0 0 2px}.medalGroupHeader span{color:#829a8b;font-size:11px}.medalGroupHeader>a{margin-left:auto;font-size:12px;font-weight:800;color:#28765a}.medalIcon{width:43px;height:43px;border-radius:13px;background:#e6f3e8;color:#288264;display:grid;place-items:center;font-size:23px}
.medalList{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}.medal{display:flex;flex-direction:column;align-items:center;text-align:center;gap:6px}.medalDisc{height:75px;width:75px;display:grid;place-items:center;background:radial-gradient(circle at 32% 25%,#dedede,#a5aaa8 65%,#838985);border:5px solid #e0e1e1;box-shadow:inset 0 0 0 3px #c4c8c5,0 7px 16px #172c1a14;border-radius:50%;filter:grayscale(1);color:#f0f1f0;font-size:32px;transition:all .3s}.medal.unlocked .medalDisc{background:radial-gradient(circle at 30% 25%,#f8ed8e,#dbab3b 63%,#aa791b);border-color:#f5d86a;box-shadow:inset 0 0 0 3px #fceca6,0 7px 20px #caac4233;filter:none;color:#fffce5}.medal strong{font-size:12px}.medal small{font-size:10px;color:#809388}.medal.unlocked small{color:#23835c;font-weight:800}
.evaluationBadge{background:#f1f8f2;border-radius:18px;padding:24px;margin-top:25px}.evalMedal{display:flex;align-items:center;gap:20px;color:#88938a}.evalMedal span{filter:grayscale(1);width:75px;height:75px;border-radius:50%;background:#bbb;display:grid;place-items:center;font-size:32px}.evalMedal.unlocked span{background:#f2c04b;color:white;filter:none}.evaluationBadge>a{color:#277c60;font-weight:800}.profileApp #demoLogout{background:#fff;color:#657c6d;border:1px solid #d7e5da;border-radius:20px;padding:11px 18px;cursor:pointer;margin-top:22px}.profileDisclaimer{font-size:11px;color:#8aa091}
@media(max-width:700px){.medalList{gap:5px}.medalDisc{height:46px;width:46px;font-size:20px;border-width:3px}.medal strong{font-size:10px}.medal small{font-size:9px}.profileScore>div{padding:12px}.profileScore strong{font-size:23px}}

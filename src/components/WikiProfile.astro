---
const names=['Localización','Sobrestock','Compras','Conteos','Entradas y salidas'];
const keys=['localizacion','sobrestock','compras','conteos','movimientos'];
const icons=['⌖','▦','↗','✓','⇄'];
---
<section class="profileApp" id="wg-profile">
 <div class="profileHero"><span class="profileEyebrow">MI ESPACIO · WIKIGARDEN</span><h2>Tu progreso tiene recompensa.</h2><p>Consulta los pasos completados y los logros que has conseguido en tu recorrido de aprendizaje.</p><div class="profileUser"><span>◉</span><strong id="profileName">Visitante</strong><span>Perfil de demostración</span></div></div>
 <div class="profileScore"><div><strong id="profileCount">0</strong><span>medallas desbloqueadas</span></div><div><strong id="profileCompleted">0</strong><span>retos completados</span></div><div><strong id="profilePct">0%</strong><span>avance total</span></div></div>
 <div class="medalIntro"><h2>Tu medallero</h2><p>Cada paso que completas desbloquea una medalla. Las pendientes permanecen en blanco y negro.</p></div>
 <div class="medalGroups">
 {keys.map((key,k)=><section class="medalGroup" data-group={key}><div class="medalGroupHeader"><div class="medalIcon">{icons[k]}</div><div><h3>{names[k]}</h3><span data-group-progress>0 de 5 pasos</span></div><a href={'/problemas/'+key+'/'}>{key==='movimientos'?'Ver reto':'Continuar'} →</a></div><div class="medalList">
 {Array.from({length:5},(_,i)=><div class="medal" data-medal={i}><span class="medalDisc"><span>★</span></span><strong>{'Paso '+(i+1)}</strong><small>Pendiente</small></div>)}
 </div></section>)}
 </div>
 <section class="evaluationBadge"><h2>Evaluación de conocimientos</h2><div class="evalMedal" id="examMedal"><span>★</span><p>Supera el test de 15 preguntas para desbloquear tu logro de conocimientos.</p></div><a href="/evaluacion/">Ir a la autoevaluación →</a></section>
 <button type="button" id="demoLogout">Salir de esta sesión</button><p class="profileDisclaimer">Los logros se guardan únicamente en este navegador. No hay sincronización entre dispositivos ni autenticación real.</p>
</section>
<script is:inline>
(function(){
 function init(){
  const root=document.getElementById('wg-profile');if(!root)return;
  let user='Visitante';try{user=sessionStorage.getItem('wikigarden:demo-user')||user}catch(e){}
  root.querySelector('#profileName').textContent=user;
  let total=0,finished=0;
  root.querySelectorAll('[data-group]').forEach(group=>{
   let done=[false,false,false,false,false];
   try{const saved=JSON.parse(localStorage.getItem('wikigarden:'+group.dataset.group+':steps:v3')||'null');if(Array.isArray(saved)&&saved.length===5)done=saved.map(Boolean)}catch(e){}
   const count=done.filter(Boolean).length;total+=count;if(count===5)finished++;
   group.querySelector('[data-group-progress]').textContent=count+' de 5 pasos';
   group.querySelectorAll('[data-medal]').forEach((el,i)=>{
    el.classList.toggle('unlocked',done[i]);el.querySelector('small').textContent=done[i]?'Desbloqueada':'Pendiente';
   });
  });
  root.querySelector('#profileCount').textContent=String(total);
  root.querySelector('#profileCompleted').textContent=String(finished);
  root.querySelector('#profilePct').textContent=Math.round(total/25*100)+'%';
  try{const exam=JSON.parse(localStorage.getItem('wikigarden:knowledge-exam:v1')||'null');if(exam?.passed)root.querySelector('#examMedal').classList.add('unlocked')}catch(e){}
  root.querySelector('#demoLogout').addEventListener('click',()=>{try{sessionStorage.removeItem('wikigarden:demo-user')}catch(e){}location.assign('/acceso/')});
 }
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});else init();
 document.addEventListener('astro:page-load',init);
})();
</script>
<style is:global>
.profileApp{font-family:Outfit,system-ui,sans-serif;color:#254a3d}.profileHero{padding:clamp(24px,4vw,40px);border-radius:23px;background:linear-gradient(130deg,#eaf4ec,#f7fbf8);border:1px solid #d7e7dc}.profileEyebrow{font-size:11px;letter-spacing:.12em;font-weight:800;color:#3a866e}.profileHero h2{font-size:clamp(28px,4vw,40px);line-height:1.14;margin:9px 0}.profileHero p{color:#618072;max-width:650px}.profileUser{display:flex;align-items:center;gap:10px;margin-top:20px}.profileUser>span:first-child{display:grid;place-items:center;background:#36846b;color:white;border-radius:50%;height:42px;width:42px}.profileUser>span:last-child{color:#7b9988;font-size:12px}
.profileScore{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:17px 0 30px}.profileScore>div{display:flex;flex-direction:column;gap:5px;padding:22px;border-radius:16px;background:white;border:1px solid #e0eae4}.profileScore strong{font-size:31px;color:#288263}.profileScore span{font-size:12px;color:#708a7a}.medalIntro h2{margin-bottom:5px}.medalIntro p{color:#738b80;margin-top:0}
.medalGroups{display:grid;gap:18px}.medalGroup{background:#fff;border:1px solid #e0e9e3;border-radius:18px;padding:20px}.medalGroupHeader{display:flex;align-items:center;gap:14px;margin-bottom:20px}.medalGroupHeader h3{font-size:19px;color:#265743;margin:0 0 2px}.medalGroupHeader span{color:#829a8b;font-size:11px}.medalGroupHeader>a{margin-left:auto;font-size:12px;font-weight:800;color:#28765a}.medalIcon{width:43px;height:43px;border-radius:13px;background:#e6f3e8;color:#288264;display:grid;place-items:center;font-size:23px}
.medalList{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}.medal{display:flex;flex-direction:column;align-items:center;text-align:center;gap:6px}.medalDisc{height:75px;width:75px;display:grid;place-items:center;background:radial-gradient(circle at 32% 25%,#dedede,#a5aaa8 65%,#838985);border:5px solid #e0e1e1;box-shadow:inset 0 0 0 3px #c4c8c5,0 7px 16px #172c1a14;border-radius:50%;filter:grayscale(1);color:#f0f1f0;font-size:32px;transition:all .3s}.medal.unlocked .medalDisc{background:radial-gradient(circle at 30% 25%,#f8ed8e,#dbab3b 63%,#aa791b);border-color:#f5d86a;box-shadow:inset 0 0 0 3px #fceca6,0 7px 20px #caac4233;filter:none;color:#fffce5}.medal strong{font-size:12px}.medal small{font-size:10px;color:#809388}.medal.unlocked small{color:#23835c;font-weight:800}
.evaluationBadge{background:#f1f8f2;border-radius:18px;padding:24px;margin-top:25px}.evalMedal{display:flex;align-items:center;gap:20px;color:#88938a}.evalMedal span{filter:grayscale(1);width:75px;height:75px;border-radius:50%;background:#bbb;display:grid;place-items:center;font-size:32px}.evalMedal.unlocked span{background:#f2c04b;color:white;filter:none}.evaluationBadge>a{color:#277c60;font-weight:800}.profileApp #demoLogout{background:#fff;color:#657c6d;border:1px solid #d7e5da;border-radius:20px;padding:11px 18px;cursor:pointer;margin-top:22px}.profileDisclaimer{font-size:11px;color:#8aa091}
@media(max-width:700px){.medalList{gap:5px}.medalDisc{height:46px;width:46px;font-size:20px;border-width:3px}.medal strong{font-size:10px}.medal small{font-size:9px}.profileScore>div{padding:12px}.profileScore strong{font-size:23px}}
</style>
<section class="opsLab" data-opslab>
 <div class="opsIntro"><span>03–05 · SIMULADORES OPERATIVOS</span><h2>De la teoría a las decisiones</h2><p>Cambia los números y comprueba cómo afectan al pedido, a la precisión del inventario y al margen de una promoción. Los resultados son ejemplos didácticos.</p></div>
 <div class="opsGrid">
 <article class="opsPanel"><span class="opsTag">03 · CANTIDAD A PEDIR</span><h3>¿Cuántas unidades necesitas comprar?</h3><label>Stock objetivo <output for="op-target" id="o-target">120</output><input id="op-target" type="range" min="0" max="500" step="5" value="120"></label><label>Stock vendible <output id="o-stock">35</output><input id="op-stock" type="range" min="0" max="400" step="5" value="35"></label><label>Unidades en tránsito <output id="o-transit">50</output><input id="op-transit" type="range" min="0" max="300" step="5" value="50"></label><label>Unidades comprometidas <output id="o-reserved">10</output><input id="op-reserved" type="range" min="0" max="100" step="5" value="10"></label><div class="opsResult"><span>Necesidad neta orientativa</span><strong id="o-order">45 <small>uds.</small></strong></div><p id="o-order-hint" class="opsHint" role="status"></p><p class="opsFormula">Máximo de 0 y (objetivo − vendible − tránsito + comprometido). Revisa fechas, mínimos y embalajes antes de pedir.</p></article>
 <article class="opsPanel"><span class="opsTag">04 · PRECISIÓN DE INVENTARIO</span><h3>¿Qué porcentaje de tus referencias cuadra?</h3><label>Referencias comprobadas <output id="o-checked">120</output><input id="op-checked" type="range" min="10" max="500" step="10" value="120"></label><label>Referencias con discrepancia <output id="o-errors">12</output><input id="op-errors" type="range" min="0" max="120" step="1" value="12"></label><div class="opsResult"><span>Exactitud por referencia</span><strong id="o-accuracy">90 <small>%</small></strong><span id="o-correct">108 de 120 referencias correctas</span></div><div class="opsCompare"><div><span>Correctas</span><div><i id="o-accuracybar"></i></div></div></div><p id="o-accuracy-hint" class="opsHint" role="status"></p><p class="opsFormula">Exactitud = referencias sin diferencias ÷ referencias comprobadas × 100. No mide magnitud ni valor económico de las discrepancias.</p></article>
 <article class="opsPanel"><span class="opsTag">05 · PROMOCIONES Y MARGEN</span><h3>¿Compensa aplicar un descuento?</h3><label>Precio habitual (€) <output id="o-price">20</output><input id="op-price" type="range" min="5" max="100" step="1" value="20"></label><label>Coste unitario (€) <output id="o-unitcost">10</output><input id="op-unitcost" type="range" min="1" max="90" step="1" value="10"></label><label>Descuento (%) <output id="o-discount">20</output><input id="op-discount" type="range" min="0" max="60" step="5" value="20"></label><label>Unidades previstas sin promoción <output id="o-baseline">30</output><input id="op-baseline" type="range" min="1" max="200" step="1" value="30"></label><label>Unidades previstas con promoción <output id="o-promo">45</output><input id="op-promo" type="range" min="1" max="250" step="1" value="45"></label><div class="opsResult"><span>Diferencia en margen bruto total</span><strong id="o-margin">−30 <small>€</small></strong><span id="o-margins">Sin promoción: 300 € · Con promoción: 270 €</span></div><p id="o-promo-hint" class="opsHint" role="status"></p><p class="opsFormula">Compara (precio − coste) × unidades y (precio rebajado − coste) × unidades. Valores supuestos sin IVA ni costes adicionales.</p></article>
 </div>
 <button class="opsReset" type="button" id="ops-reset">↺ Restablecer los tres ejercicios</button>
</section>
<script>
function initOpsLab(){
 const root=document.querySelector('[data-opslab]');if(!root||root.dataset.ready)return;root.dataset.ready='1';
 const get=id=>root.querySelector('#'+id),v=id=>Number(get('op-'+id).value);
 const number=n=>new Intl.NumberFormat('es-ES',{maximumFractionDigits:0}).format(n);
 function update(){
  for(const id of ['target','stock','transit','reserved','checked','errors','price','unitcost','discount','baseline','promo'])get('o-'+id).textContent=number(v(id));
  const need=Math.max(0,v('target')-v('stock')-v('transit')+v('reserved'));
  get('o-order').innerHTML=number(need)+' <small>uds.</small>';
  get('o-order-hint').textContent=need===0?'Con estos datos no necesitas nuevas unidades. Revisa la fecha del próximo suministro.':'Antes de enviar el pedido, comprueba la llegada del stock en tránsito y los múltiplos del proveedor.';
  const checked=v('checked'),errors=v('errors'),valid=errors<=checked,correct=Math.max(0,checked-errors),accuracy=correct/checked*100;
  get('o-accuracy').innerHTML=(valid?accuracy.toLocaleString('es-ES',{maximumFractionDigits:1}):'—')+' <small>%</small>';
  get('o-correct').textContent=valid?number(correct)+' de '+number(checked)+' referencias correctas':'Las diferencias no pueden superar las referencias comprobadas';
  get('o-accuracybar').style.width=(valid?accuracy:0)+'%';
  get('o-accuracy-hint').textContent=!valid?'Revisa los datos: no puede haber más referencias con diferencias que referencias comprobadas.':accuracy>=98?'Precisión alta por referencia. Comprueba también el valor y la magnitud de las diferencias.':accuracy>=90?'Hay margen de mejora. Investiga qué tipos de movimientos generan más errores.':'Precisión baja en este ejemplo. Prioriza recuentos e investigación de las causas.';
  const price=v('price'),cost=v('unitcost'),promoPrice=price*(1-v('discount')/100),without=(price-cost)*v('baseline'),withPromo=(promoPrice-cost)*v('promo'),delta=withPromo-without;
  const euro=n=>new Intl.NumberFormat('es-ES',{style:'currency',currency:'EUR',maximumFractionDigits:2}).format(n);
  get('o-margin').innerHTML=(delta>=0?'+':'')+euro(delta);
  get('o-margins').textContent='Sin promoción: '+euro(without)+' · Con promoción: '+euro(withPromo);
  get('o-promo-hint').textContent=price<=cost?'El precio habitual no supera el coste. Revisa el supuesto antes de interpretar el margen.':promoPrice<cost?'El descuento deja el precio por debajo del coste unitario. Riesgo de margen negativo.':delta>0?'Con estas ventas previstas, el margen bruto total mejora. Comprueba que el incremento de demanda sea realista.':delta===0?'El margen bruto total queda igual en ambos escenarios.':'El descuento no genera suficiente volumen adicional para mantener el margen bruto total.';
 }
 root.querySelectorAll('input').forEach(el=>el.addEventListener('input',update));
 get('ops-reset').addEventListener('click',()=>{for(const el of root.querySelectorAll('input'))el.value=el.defaultValue;update()});update()
}
initOpsLab();document.addEventListener('astro:page-load',initOpsLab);
</script>
<style>
.opsLab{font-family:Outfit,system-ui,sans-serif;margin:35px 0;color:#25453a}.opsIntro{margin-bottom:22px}.opsIntro>span,.opsTag{font-size:10px;font-weight:800;color:#368875;letter-spacing:.12em}.opsIntro h2{font-size:clamp(24px,3vw,32px);letter-spacing:-.04em;margin:9px 0}.opsIntro p{font-size:14px;color:#648071;line-height:1.65;max-width:750px}.opsGrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;align-items:stretch}.opsPanel{margin:0!important;background:#fff;border:1px solid #dcebe2;border-radius:17px;padding:20px;display:flex;flex-direction:column;gap:13px;min-width:0}.opsPanel h3{font-size:18px;line-height:1.3;margin:0 0 5px;color:#284f41;min-height:46px}.opsPanel label{font-size:12px;font-weight:600;color:#5c766a;display:block;margin:0}.opsPanel output{float:right;font-weight:800;color:#287c66}.opsPanel input[type=range]{width:100%;display:block;margin-top:10px;accent-color:#45968a;cursor:pointer}.opsResult{background:#eaf5ee;border-radius:12px;padding:15px;display:flex;flex-direction:column;gap:6px;margin-top:auto}.opsResult>span{font-size:11px;line-height:1.5;color:#547668}.opsResult strong{color:#23745e;font-size:32px;line-height:1.1;letter-spacing:-.04em}.opsResult strong small{font-size:12px}.opsHint{font-size:12px;color:#487664;line-height:1.55;margin:0;min-height:58px}.opsFormula{font-size:11px;line-height:1.5;color:#7c9187;margin:0;padding-top:10px;border-top:1px solid #e6efe9}.opsCompare{display:flex;flex-direction:column;gap:9px}.opsCompare>div{display:grid;grid-template-columns:58px 1fr;align-items:center;gap:10px;font-size:11px;color:#648073}.opsCompare>div>div{height:7px;border-radius:20px;background:#e4efe8;overflow:hidden}.opsCompare i{display:block;height:100%;background:#45968a;border-radius:20px}.opsReset{display:inline-flex;align-items:center;margin-top:16px;border:1px solid #c5ddd0;border-radius:25px;background:white;color:#2b7a65;font:700 12px Outfit,system-ui,sans-serif;padding:10px 16px;cursor:pointer}.opsReset:hover{background:#ecf7ef}@media(max-width:1050px){.opsGrid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:700px){.opsGrid{grid-template-columns:1fr}.opsPanel h3{min-height:0}}
</style>
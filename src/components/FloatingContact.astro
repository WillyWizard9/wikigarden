---
---
<div class="wgHelp" data-wg-help>
 <button type="button" class="wgHelpTrigger" aria-label="¿Tienes dudas? Contactar con Cymara" aria-haspopup="dialog" data-help-open>
  <span class="wgHelpBubble" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg></span>
  <span class="wgHelpText">¿Tienes dudas?</span>
 </button>
 <dialog class="wgHelpDialog" aria-labelledby="wgHelpTitle" aria-describedby="wgHelpDescription" data-help-dialog>
  <div class="wgHelpHeader">
   <div class="wgHelpHeading"><span class="wgHelpIcon" aria-hidden="true">✳</span><div><span class="wgHelpKicker">ESTAMOS PARA AYUDARTE</span><h2 id="wgHelpTitle">¿Tienes alguna duda?</h2></div></div>
   <button type="button" class="wgHelpClose" aria-label="Cerrar formulario de contacto" data-help-close>×</button>
  </div>
  <p id="wgHelpDescription" class="wgHelpIntro">Cuéntanos qué necesitas y el equipo de Cymara se pondrá en contacto contigo.</p>
  <form class="wgHelpForm" data-help-form>
   <div class="wgHelpTrap" aria-hidden="true"><label>No rellenar <input name="website" tabindex="-1" autocomplete="off"/></label></div>
   <label>Nombre del garden <input name="garden" type="text" autocomplete="organization" placeholder="Nombre de tu garden" maxlength="120" required /></label>
   <label>Tu email <input name="email" type="email" autocomplete="email" placeholder="nombre@garden.es" maxlength="180" required /></label>
   <label>¿Sobre qué necesitas ayuda?
    <select name="problema" required>
     <option value="" disabled selected>Selecciona un tema</option>
     <option value="Stock mal localizado">Localización del stock</option>
     <option value="Sobrestock">Sobrestock</option>
     <option value="Planificación de compras">Compras y reposición</option>
     <option value="Conteos poco fiables">Conteos e inventario físico</option>
     <option value="Entradas y salidas de mercancía">Entradas y salidas de mercancía</option>
    </select>
   </label>
   <label class="wgHelpOptional">Tu consulta <span>(opcional)</span><textarea name="detalle" rows="3" maxlength="3000" placeholder="Cuéntanos brevemente qué sucede..."></textarea></label>
   <p class="wgHelpPrivacy">Enviaremos tu consulta a Cymara para poder responderte. No tienes que salir de WikiGarden.</p>
   <button type="submit" class="wgHelpSubmit">Enviar consulta <span aria-hidden="true">→</span></button>
   <p role="status" class="wgHelpStatus" aria-live="polite" data-help-status></p>
  </form>
 </dialog>
</div>
<script is:inline>
(function(){
 function init(){
  const widget=document.querySelector('[data-wg-help]');
  if(!widget||widget.dataset.ready==='1')return;
  widget.dataset.ready='1';
  const path=location.pathname;
  // Enlaces flotantes únicamente en las páginas con contenido de WikiGarden.
  if(!path.startsWith('/problemas/')){
   widget.hidden=true;return;
  }
  const area={
   localizacion:'Stock mal localizado',
   sobrestock:'Sobrestock',
   compras:'Planificación de compras',
   conteos:'Conteos poco fiables',
   movimientos:'Entradas y salidas de mercancía'
  };
  const dialog=widget.querySelector('[data-help-dialog]');
  const form=widget.querySelector('[data-help-form]');
  const status=widget.querySelector('[data-help-status]');
  const submit=form.querySelector('[type="submit"]');
  const topic=form.querySelector('[name="problema"]');
  const slug=path.split('/').filter(Boolean)[1];
  if(area[slug])topic.value=area[slug];
  const trigger=widget.querySelector('[data-help-open]');
  function close(){
   if(dialog.open)dialog.close();
   else dialog.removeAttribute('open');
  }
  trigger.addEventListener('click',()=>{
   if(!dialog.open){
    try{dialog.showModal()}catch(e){dialog.setAttribute('open','')}
    status.textContent='';
    form.querySelector('[name="garden"]').focus();
   }
  });
  widget.querySelector('[data-help-close]').addEventListener('click',close);
  dialog.addEventListener('click',e=>{if(e.target===dialog)close()});
  dialog.addEventListener('close',()=>trigger.focus());
  form.addEventListener('submit',async e=>{
   e.preventDefault();
   if(!form.reportValidity()||submit.disabled)return;
   const fields=new FormData(form);
   submit.disabled=true;submit.textContent='Enviando…';
   status.textContent='Enviando tu consulta…';
   try{
    const response=await fetch('/api/contact',{
     method:'POST',headers:{'Content-Type':'application/json'},
     body:JSON.stringify({
      garden:fields.get('garden'),email:fields.get('email'),
      problemas:[fields.get('problema')],detalle:fields.get('detalle'),
      website:fields.get('website'),source:location.pathname+' (formulario flotante)'
     })
    });
    const result=await response.json();
    if(!response.ok||!result.ok)throw new Error(result.error||'No hemos podido enviar tu consulta.');
    form.reset();
    if(area[slug])topic.value=area[slug];
    status.textContent='¡Consulta enviada! El equipo de Cymara se pondrá en contacto contigo.';
   }catch(error){
    status.textContent=(error instanceof Error?error.message:'Error de conexión.')+' También puedes escribir a info@cymara.es.';
   }finally{submit.disabled=false;submit.innerHTML='Enviar consulta <span aria-hidden="true">→</span>'}
  });
 }
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});else init();
 document.addEventListener('astro:page-load',init);
})();
</script>
<style is:global>
.wgHelp[hidden]{display:none!important}
.wgHelpTrigger{position:fixed!important;right:clamp(16px,3vw,34px)!important;bottom:clamp(16px,3vw,30px)!important;z-index:900!important;background:#277a62!important;color:#fff!important;border:1px solid #358b70!important;border-radius:100px!important;padding:10px 18px 10px 11px!important;display:flex!important;align-items:center!important;gap:10px!important;box-shadow:0 12px 35px #133d2e50!important;font:800 13px Outfit,system-ui,sans-serif!important;cursor:pointer!important;transition:transform .18s,background .18s!important}
.wgHelpTrigger:hover{background:#195e49!important;transform:translateY(-3px)!important}.wgHelpTrigger:focus-visible{outline:3px solid #a2d9c5!important;outline-offset:3px!important}
.wgHelpBubble{height:35px;width:35px;border-radius:50%;display:grid;place-items:center;background:#ffffff25}.wgHelpBubble svg{width:20px;height:20px}
.wgHelpDialog{position:fixed!important;inset:0!important;width:min(calc(100% - 28px),445px)!important;height:auto!important;max-height:min(85dvh,720px)!important;margin:auto!important;padding:0!important;border:1px solid #d6e6db!important;border-radius:22px!important;overflow:auto!important;background:#fff!important;color:#214d3b!important;box-shadow:0 28px 80px #112b2055!important;z-index:10000!important;font-family:Outfit,system-ui,sans-serif!important}
.wgHelpDialog:not([open]){display:none!important}.wgHelpDialog::backdrop{background:#0a2b2066;backdrop-filter:blur(3px)}
.wgHelpHeader{padding:23px 23px 0;display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.wgHelpHeading{display:flex;align-items:center;gap:11px}.wgHelpIcon{background:#e4f4e9;border-radius:12px;color:#257e61;width:43px;height:43px;display:grid;place-items:center;font-size:24px;flex:none}.wgHelpKicker{color:#36886c;font-weight:800;font-size:10px;letter-spacing:.12em}.wgHelpDialog h2{font:800 24px/1.15 Outfit,system-ui,sans-serif!important;color:#204d39!important;letter-spacing:-.04em;margin:4px 0 0!important}.wgHelpClose{height:33px;width:33px;border-radius:50%;border:0;background:#f1f6f2;color:#466b58;font-size:26px;line-height:1;cursor:pointer;flex:none}
.wgHelpIntro{margin:12px 23px 18px!important;color:#6b8173;font-size:13px!important;line-height:1.55!important}.wgHelpForm{display:grid;gap:12px;padding:0 23px 23px!important;margin:0!important}.wgHelpForm label{display:grid;gap:6px;color:#2f5d48;font-size:12px;font-weight:800;margin:0!important}.wgHelpForm input,.wgHelpForm select,.wgHelpForm textarea{width:100%;min-width:0;box-sizing:border-box;border:1px solid #d8e6dc;background:#f9fcfa;border-radius:10px;padding:11px 13px;font:500 13px Outfit,system-ui,sans-serif!important;color:#284c3d;resize:vertical}.wgHelpForm textarea{min-height:66px}.wgHelpForm input:focus-visible,.wgHelpForm select:focus-visible,.wgHelpForm textarea:focus-visible{outline:2px solid #409975;outline-offset:1px}.wgHelpOptional span{font-weight:400;color:#82978b}.wgHelpPrivacy{font-size:10px!important;line-height:1.5!important;color:#7c9283;margin:1px 0 0!important}.wgHelpSubmit{display:flex;justify-content:center;gap:12px;align-items:center;min-height:45px;border:0!important;border-radius:12px!important;background:#2d8769!important;color:white!important;font:800 13px Outfit,system-ui,sans-serif!important;cursor:pointer!important;margin:0!important}.wgHelpSubmit:disabled{opacity:.6;cursor:wait!important}.wgHelpStatus{font-size:12px!important;line-height:1.5!important;color:#287557;margin:0!important}.wgHelpStatus:empty{display:none}.wgHelpTrap{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
@media(max-width:590px){.wgHelpTrigger{padding:10px 13px!important}.wgHelpText{font-size:12px}.wgHelpDialog{max-height:90dvh!important}.wgHelpHeader{padding:18px 18px 0}.wgHelpIntro{margin:10px 18px 16px!important}.wgHelpForm{padding:0 18px 18px!important}}
@media(prefers-reduced-motion:reduce){.wgHelpTrigger{transition:none!important}}
</style>
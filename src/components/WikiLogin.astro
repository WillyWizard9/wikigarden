---
const aliatLogo="data:image/png;base64,";
---
<section class="loginShell">
 <div class="loginScene"><div class="loginSceneInner"><span>WIKIGARDEN · ALIAT</span><h2>Conocimiento que hace crecer tu garden.</h2><p>Descubre cómo llevar el control del inventario a otro nivel.</p></div></div>
 <div class="loginCard"><div class="loginBrand"><img src="/favicon.svg" alt="" /><h1>Wiki<span>Garden</span></h1><p>Tu espacio de aprendizaje y mejora del inventario</p></div>
 <form id="wg-login"><h2>Bienvenido</h2><p>Introduce tu usuario y contraseña para continuar.</p><label>Usuario<input name="username" type="text" autocomplete="username" required placeholder="Tu nombre o usuario"/></label><label>Contraseña<span class="loginPasswordField"><input name="password" type="password" autocomplete="current-password" required placeholder="Tu contraseña"/><button type="button" class="loginPasswordToggle" aria-label="Mostrar contraseña" aria-pressed="false" title="Mostrar contraseña">Mostrar</button></span></label><button type="submit">Entrar a WikiGarden →</button><small>Acceso de demostración: cualquier usuario y contraseña permite entrar. Este formulario no autentica identidades ni protege información privada.</small><button type="button" id="wg-forgot-password" class="loginTextButton">¿No recuerdas tu contraseña?</button></form><form id="wg-recover" hidden><h2>Recuperar contraseña</h2><p>Escribe tu email y te enviaremos un enlace para elegir una contraseña nueva.</p><label>Email<input name="recoveryEmail" type="email" autocomplete="email" required placeholder="tu@garden.es"/></label><button type="submit">Enviar enlace →</button><p role="status" aria-live="polite" data-recovery-status></p><button type="button" class="loginTextButton" id="wg-back-login">Volver a iniciar sesión</button></form><form id="wg-accept-invite" hidden><h2 id="wg-password-title">Establece tu contraseña</h2><p id="wg-password-description">Elige una contraseña segura para acceder a WikiGarden.</p><label>Contraseña nueva<input name="newPassword" type="password" autocomplete="new-password" minlength="10" required placeholder="Mínimo 10 caracteres"/></label><label>Repite la contraseña<input name="confirmPassword" type="password" autocomplete="new-password" minlength="10" required /></label><button type="submit">Activar mi cuenta →</button><p role="alert" data-invite-error></p></form>
 <div class="loginPartners"><span>UNA INICIATIVA DE</span><div><div class="loginPartner"><img src={aliatLogo} alt="ALIAT" /><b>ALIAT</b></div><div class="loginPartner"><img src="/cymara-brand.svg" alt="Cymara" /></div><div class="loginPartner"><img src="/vithal-garden-clean.svg" alt="Vithal Garden" /></div></div></div></div>
</section>
<script is:inline>
(function(){
 const login=document.getElementById('wg-login');
 const recover=document.getElementById('wg-recover');
 const setPassword=document.getElementById('wg-accept-invite');
 if(!login||!recover||!setPassword)return;
 const username=login.querySelector('[name="username"]');
 const password=login.querySelector('[name="password"]');
 const togglePassword=login.querySelector('.loginPasswordToggle');
 togglePassword.addEventListener('click',()=>{
  const visible=password.type==='password';
  password.type=visible?'text':'password';
  togglePassword.textContent=visible?'Ocultar':'Mostrar';
  togglePassword.setAttribute('aria-label',visible?'Ocultar contraseña':'Mostrar contraseña');
  togglePassword.setAttribute('aria-pressed',String(visible));
  togglePassword.title=visible?'Ocultar contraseña':'Mostrar contraseña';
 });
 const submit=login.querySelector('[type="submit"]');
 const helper=login.querySelector('small');
 const message=document.createElement('p');message.setAttribute('role','alert');message.style.cssText='color:#a53d35;font-size:13px;margin:0';login.appendChild(message);
 const action=new URLSearchParams(location.search).get('action')||new URLSearchParams(location.hash.slice(1)).get('type')||'';
 const creatingPassword=action==='recovery'||action==='invite';
 function show(element){for(const f of [login,recover,setPassword])f.hidden=f!==element}
 if(creatingPassword){
  show(setPassword);
  document.getElementById('wg-password-title').textContent=action==='recovery'?'Cambia tu contraseña':'Activa tu cuenta';
  document.getElementById('wg-password-description').textContent=action==='recovery'?'Introduce la nueva contraseña para tu cuenta WikiGarden.':'Elige una contraseña segura para acceder a WikiGarden.';
 }
 async function authReady(){
  // Espera a la recuperación de sesión de Supabase sin redirigir al usuario.
  const auth=window.wikiAuth;
  if(!auth)return;
  await auth.ready;
  if(creatingPassword){
   if(!auth.user)setPassword.querySelector('[data-invite-error]').textContent='No hay una sesión de recuperación válida. Solicita un nuevo enlace.';
   return;
  }
  if(!auth.enabled)return;
  username.type='email';username.autocomplete='email';username.placeholder='tu@garden.es';
  username.closest('label').firstChild.textContent='Correo electrónico';
  helper.textContent='Acceso exclusivo para usuarios invitados. Introduce tu email y contraseña.';
  if(auth.user){
   const next=new URLSearchParams(location.search).get('next')||'/';
   location.replace(next.startsWith('/')&&!next.startsWith('//')&&!next.startsWith('/acceso')?next:'/');
  }
 }
 document.addEventListener('wikigarden:auth-initialized',authReady);
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',authReady,{once:true});else authReady();
 document.getElementById('wg-forgot-password').addEventListener('click',()=>{
  show(recover);recover.querySelector('[name="recoveryEmail"]').value=username.type==='email'?username.value:'';
 });
 document.getElementById('wg-back-login').addEventListener('click',()=>show(login));
 recover.addEventListener('submit',async e=>{
  e.preventDefault();if(!recover.reportValidity())return;
  const btn=recover.querySelector('[type="submit"]');
  const status=recover.querySelector('[data-recovery-status]');
  btn.disabled=true;status.textContent='Solicitando enlace…';
  try{
   const auth=window.wikiAuth;
   if(!auth)throw new Error('La conexión todavía no está disponible.');
   const {error}=await auth.client.auth.resetPasswordForEmail(recover.querySelector('[name="recoveryEmail"]').value.trim(),{redirectTo:location.origin+'/acceso/?action=recovery'});
   if(error)throw error;
   status.textContent='Si la cuenta está registrada, recibirás un enlace para establecer una contraseña.';
  }catch(err){status.textContent='No pudimos solicitar el enlace. Revisa el email o inténtalo de nuevo.'}
  finally{btn.disabled=false}
 });
 setPassword.addEventListener('submit',async e=>{
  e.preventDefault();if(!setPassword.reportValidity())return;
  const one=setPassword.querySelector('[name="newPassword"]').value;
  const two=setPassword.querySelector('[name="confirmPassword"]').value;
  const status=setPassword.querySelector('[data-invite-error]');
  if(one!==two){status.textContent='Las contraseñas no coinciden.';return}
  const btn=setPassword.querySelector('[type="submit"]');
  btn.disabled=true;btn.textContent='Guardando contraseña…';
  try{
   const auth=window.wikiAuth;
   if(!auth)throw new Error('Conexión no disponible.');
   await auth.ready;
   const user=await auth.client.auth.getUser();
   if(user.error||!user.data?.user)throw new Error('Enlace caducado o no válido.');
   const {error}=await auth.client.auth.updateUser({password:one});
   if(error)throw error;
   await auth.client.auth.signOut();
   await fetch('/api/wiki-session',{method:'DELETE'}).catch(()=>{});
   status.style.color='#207856';
   status.textContent='Contraseña guardada correctamente. Ya puedes iniciar sesión cuando se active el acceso real.';
   btn.hidden=true;
   setPassword.reset();
  }catch(err){status.textContent='No se pudo guardar la contraseña. Solicita otro enlace de recuperación.';btn.disabled=false;btn.textContent='Guardar contraseña →'}
 });
 login.addEventListener('submit',async e=>{
  e.preventDefault();if(!login.reportValidity())return;
  message.textContent='';
  const requested=new URLSearchParams(location.search).get('next')||'/';
  const target=requested.startsWith('/')&&!requested.startsWith('//')&&!requested.startsWith('/acceso')?requested:'/';
  const auth=window.wikiAuth;
  if(auth)await auth.ready;
  if(auth?.enabled){
   submit.disabled=true;submit.textContent='Comprobando acceso…';
   try{await auth.login(username.value.trim(),password.value);location.assign(target)}
   catch(err){message.textContent='No hemos podido iniciar sesión. Comprueba tus credenciales o contacta con el administrador.';console.error('WikiGarden: fallo de acceso',err)}
   finally{submit.disabled=false;submit.textContent='Entrar a WikiGarden →'}
  }else{
   const user=username.value.trim()||'Visitante';
   try{sessionStorage.setItem('wikigarden:demo-user',user)}catch(err){}
   location.assign(target);
  }
 });
})();
</script>
<style is:global>
body:has(.loginShell) header.header,body:has(.loginShell) .right-sidebar,body:has(.loginShell) .sidebar,body:has(.loginShell) .content-panel>h1,body:has(.loginShell) .pagination-links,body:has(.loginShell) footer{display:none!important}
body:has(.loginShell) main{max-width:none!important;margin:0!important;padding:0!important;width:100%!important}body:has(.loginShell) .main-pane,body:has(.loginShell) .content-panel,body:has(.loginShell) .sl-container{max-width:none!important;margin:0!important;padding:0!important}
.loginShell{display:grid;grid-template-columns:1fr 1fr;min-height:100vh;font-family:Outfit,system-ui,sans-serif;background:#f7faf7;color:#234d3c}
.loginScene{background:linear-gradient(130deg,#143c2b88,#0d3828ab),url('https://images.unsplash.com/photo-1768435581673-d6e443af9ed6?auto=format&fit=crop&w=1200&q=80') center/cover;display:flex;align-items:flex-start;padding:clamp(28px,6vw,90px);padding-top:clamp(70px,12vh,140px)}.loginSceneInner{max-width:530px;color:#fff}.loginSceneInner span{font-size:12px;letter-spacing:.14em;font-weight:800}.loginSceneInner h2{color:white;font-size:clamp(34px,5vw,65px);letter-spacing:-.055em;line-height:1.1;margin:18px 0}.loginSceneInner p{font-size:17px;line-height:1.6;color:#e3f4e8}
.loginCard{display:flex;flex-direction:column;justify-content:center;align-items:center;padding:45px 25px;gap:35px}.loginBrand{text-align:center}.loginBrand img{width:66px;height:66px}.loginBrand h1{font-size:36px!important;letter-spacing:-.05em;margin:8px 0!important;color:#1b3d31}.loginBrand h1 span{color:#378e70}.loginBrand p{font-size:13px;color:#638073}
.loginCard form[hidden]{display:none!important}.loginTextButton{background:transparent!important;color:#28775a!important;border:0!important;padding:5px!important;text-decoration:underline;font-size:12px!important;text-align:center;box-shadow:none!important}.loginCard button[hidden]{display:none!important}.loginCard form[hidden]{display:none!important}.loginCard form{width:100%;max-width:440px;background:white;border:1px solid #dce9e0;border-radius:22px;padding:32px;box-shadow:0 20px 65px #20442d0c;display:grid;gap:15px}.loginCard form h2{font-size:24px;margin:0;color:#1b4033}.loginCard form>p{font-size:13px;color:#71867a;margin:0 0 6px}.loginCard label{display:grid;gap:8px;font-size:13px;font-weight:800}.loginCard input{background:#f9fbfa;border:1px solid #dbe6df;border-radius:11px;padding:13px;font:inherit;color:#243d32;min-width:0}.loginCard button{background:#2f8064;color:white;font-weight:800;border:0;border-radius:13px;padding:15px;cursor:pointer}.loginCard label{min-width:0;max-width:100%}.loginCard .loginPasswordField{position:relative;display:block;box-sizing:border-box;width:100%;max-width:100%;min-width:0}.loginCard .loginPasswordField input{display:block;box-sizing:border-box;width:100%;max-width:100%;min-width:0;margin:0;padding-right:100px}.loginCard .loginPasswordToggle{position:absolute;right:6px;top:50%;transform:translateY(-50%);background:#e7f2ec;color:#245e4b;border:0;border-radius:8px;padding:8px 12px;font-size:12px;line-height:1.3;box-shadow:none}.loginCard .loginPasswordToggle:hover{background:#d5e8dd}.loginCard .loginPasswordToggle:focus-visible{outline:2px solid #26785e;outline-offset:2px}
.loginCard small{font-size:10px;color:#7c9185;line-height:1.5}.loginPartners{text-align:center;width:100%;max-width:470px}.loginPartners>span{color:#92a79c;letter-spacing:.12em;font-weight:800;font-size:10px}.loginPartners>div{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-top:15px}.loginPartner{display:flex;align-items:center;justify-content:center;gap:8px;font-size:15px;color:#295943;font-weight:800}.loginPartner img{width:38px;height:38px;object-fit:contain}.loginPartner:nth-child(2) img{width:115px;height:45px}.loginPartner:last-child img{width:110px;height:55px}
@media(max-width:850px){.loginShell{grid-template-columns:1fr}.loginScene{min-height:210px;padding:30px}.loginSceneInner h2{font-size:29px}.loginSceneInner p{font-size:13px}.loginCard{gap:20px;padding:25px 15px}.loginCard form{padding:22px}}
</style>
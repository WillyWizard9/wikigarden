---
const aliatLogo="data:image/png;base64,";
---
<section class="loginShell">
 <div class="loginScene"><div class="loginSceneInner"><span>WIKIGARDEN · ALIAT</span><h2>Conocimiento que hace crecer tu garden.</h2><p>Descubre cómo llevar el control del inventario a otro nivel.</p></div></div>
 <div class="loginCard"><div class="loginBrand"><img src="/favicon.svg" alt="" /><h1>Wiki<span>Garden</span></h1><p>Tu espacio de aprendizaje y mejora del inventario</p></div>
 <form id="wg-login"><h2>Bienvenido</h2><p>Introduce tu usuario y contraseña para continuar.</p><label>Usuario<input name="username" type="text" autocomplete="username" required placeholder="Tu nombre o usuario"/></label><label>Contraseña<input name="password" type="password" autocomplete="current-password" required placeholder="Tu contraseña"/></label><button type="submit">Entrar a WikiGarden →</button><small>Acceso de demostración: cualquier usuario y contraseña permite entrar. Este formulario no autentica identidades ni protege información privada.</small></form>
 <div class="loginPartners"><span>UNA INICIATIVA DE</span><div><div class="loginPartner"><img src={aliatLogo} alt="ALIAT" /><b>ALIAT</b></div><div class="loginPartner"><img src="/cymara-brand.svg" alt="Cymara" /></div><div class="loginPartner"><img src="/vithal-garden-clean.svg" alt="Vithal Garden" /></div></div></div></div>
</section>
<script is:inline>
(function(){
 const form=document.getElementById('wg-login');if(!form)return;
 const username=form.querySelector('[name="username"]'),password=form.querySelector('[name="password"]'),button=form.querySelector('[type="submit"]'),helper=form.querySelector('small');
 const message=document.createElement('p');message.setAttribute('role','alert');message.style.cssText='color:#a53d35;font-size:13px;margin:0';form.appendChild(message);
 async function mode(){
  const auth=window.wikiAuth;
  if(!auth)return;
  await auth.ready;
  if(!auth.enabled)return;
  username.type='email';username.autocomplete='email';username.placeholder='tu@garden.es';username.closest('label').firstChild.textContent='Correo electrónico';
  helper.textContent='Acceso exclusivo para usuarios invitados. Introduce el email y la contraseña de tu cuenta de WikiGarden.';
  if(auth.user){const next=new URLSearchParams(location.search).get('next')||'/';location.replace(next.startsWith('/')&&!next.startsWith('//')&&!next.startsWith('/acceso')?next:'/')}
 }
 document.addEventListener('wikigarden:auth-initialized',mode);
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',mode,{once:true});else mode();
 form.addEventListener('submit',async e=>{
  e.preventDefault();if(!form.reportValidity())return;
  message.textContent='';
  const requested=new URLSearchParams(location.search).get('next')||'/';
  const target=requested.startsWith('/')&&!requested.startsWith('//')&&!requested.startsWith('/acceso')?requested:'/';
  const auth=window.wikiAuth;
  if(auth){await auth.ready}
  if(auth?.enabled){
   button.disabled=true;button.textContent='Comprobando acceso…';
   try{await auth.login(username.value.trim(),password.value);location.assign(target)}
   catch(error){message.textContent='No hemos podido iniciar sesión. Comprueba tus credenciales o contacta con el administrador.';console.error('WikiGarden: fallo de acceso',error)}
   finally{button.disabled=false;button.textContent='Entrar a WikiGarden →'}
  }else{
   const user=username.value.trim()||'Visitante';
   try{sessionStorage.setItem('wikigarden:demo-user',user)}catch(e){}
   location.assign(target);
  }
 });
})();
</script>
<style is:global>
body:has(.loginShell) header.header,body:has(.loginShell) .right-sidebar,body:has(.loginShell) .sidebar,body:has(.loginShell) .content-panel>h1,body:has(.loginShell) .pagination-links,body:has(.loginShell) footer{display:none!important}
body:has(.loginShell) main{max-width:none!important;margin:0!important;padding:0!important;width:100%!important}body:has(.loginShell) .main-pane,body:has(.loginShell) .content-panel,body:has(.loginShell) .sl-container{max-width:none!important;margin:0!important;padding:0!important}
.loginShell{display:grid;grid-template-columns:1fr 1fr;min-height:100vh;font-family:Outfit,system-ui,sans-serif;background:#f7faf7;color:#234d3c}
.loginScene{background:linear-gradient(130deg,#143c2b88,#0d3828ab),url('https://images.unsplash.com/photo-1768435581673-d6e443af9ed6?auto=format&fit=crop&w=1200&q=80') center/cover;display:flex;align-items:flex-end;padding:clamp(28px,6vw,90px)}.loginSceneInner{max-width:530px;color:#fff}.loginSceneInner span{font-size:12px;letter-spacing:.14em;font-weight:800}.loginSceneInner h2{color:white;font-size:clamp(34px,5vw,65px);letter-spacing:-.055em;line-height:1.1;margin:18px 0}.loginSceneInner p{font-size:17px;line-height:1.6;color:#e3f4e8}
.loginCard{display:flex;flex-direction:column;justify-content:center;align-items:center;padding:45px 25px;gap:35px}.loginBrand{text-align:center}.loginBrand img{width:66px;height:66px}.loginBrand h1{font-size:36px!important;letter-spacing:-.05em;margin:8px 0!important;color:#1b3d31}.loginBrand h1 span{color:#378e70}.loginBrand p{font-size:13px;color:#638073}
.loginCard form{width:100%;max-width:440px;background:white;border:1px solid #dce9e0;border-radius:22px;padding:32px;box-shadow:0 20px 65px #20442d0c;display:grid;gap:15px}.loginCard form h2{font-size:24px;margin:0;color:#1b4033}.loginCard form>p{font-size:13px;color:#71867a;margin:0 0 6px}.loginCard label{display:grid;gap:8px;font-size:13px;font-weight:800}.loginCard input{background:#f9fbfa;border:1px solid #dbe6df;border-radius:11px;padding:13px;font:inherit;color:#243d32;min-width:0}.loginCard button{background:#2f8064;color:white;font-weight:800;border:0;border-radius:13px;padding:15px;cursor:pointer}.loginCard small{font-size:10px;color:#7c9185;line-height:1.5}.loginPartners{text-align:center;width:100%;max-width:470px}.loginPartners>span{color:#92a79c;letter-spacing:.12em;font-weight:800;font-size:10px}.loginPartners>div{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-top:15px}.loginPartner{display:flex;align-items:center;justify-content:center;gap:8px;font-size:15px;color:#295943;font-weight:800}.loginPartner img{width:38px;height:38px;object-fit:contain}.loginPartner:nth-child(2) img{width:115px;height:45px}.loginPartner:last-child img{width:110px;height:55px}
@media(max-width:850px){.loginShell{grid-template-columns:1fr}.loginScene{min-height:210px;padding:30px}.loginSceneInner h2{font-size:29px}.loginSceneInner p{font-size:13px}.loginCard{gap:20px;padding:25px 15px}.loginCard form{padding:22px}}
</style>
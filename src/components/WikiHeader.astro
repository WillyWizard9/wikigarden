---
import DefaultHeader from '@astrojs/starlight/components/Header.astro';
---
<div class="wg-header">
  <DefaultHeader />
  <div class="wg-branding">
    <a href="/" class="wg-logo" aria-label="WikiGarden, inicio"><img src="data:image/png;base64," alt="Cymara" /></a>
    <span class="wg-separator"></span>
    <div class="wg-sponsor"><span>CON EL PATROCINIO DE</span><b>vithal<small>GARDEN</small></b></div>
  </div>
  <a class="wg-wordmark" href="/">wiki<span>garden</span></a>
  <details class="wg-menu"><summary>Contenidos <span aria-hidden="true">⌄</span></summary>
    <nav aria-label="Todas las secciones">
      <a href="/">Inicio</a><a href="/autodiagnostico/">Autodiagnóstico</a>
      <span class="wg-menu-title">LOS CUATRO RETOS</span>
      <a href="/problemas/localizacion/">01 · Localización</a><a href="/problemas/sobrestock/">02 · Sobrestock</a><a href="/problemas/compras/">03 · Compras</a><a href="/problemas/conteos/">04 · Conteos</a>
      <span class="wg-menu-title">RECURSOS</span>
      <a href="/laboratorio/">Laboratorio interactivo</a><a href="/plantillas/">Plantillas</a><a href="/glosario/">Glosario</a><a href="/#contacto">Contacto</a>
    </nav>
  </details>
</div>
<style>
.wg-header{height:100%;position:relative;display:flex;align-items:center;width:100%;min-width:0}
.wg-header>header{width:100%;padding-inline:var(--sl-nav-pad-x,1rem);background:#fff}
.wg-branding{position:absolute;left:14px;display:flex;align-items:center;gap:12px;pointer-events:auto}
.wg-logo{display:flex;align-items:center}.wg-logo img{width:140px;height:auto;max-height:40px;object-fit:contain}
.wg-separator{height:30px;width:1px;background:#d9e5de}.wg-sponsor{display:flex;flex-direction:column;gap:2px;line-height:1}
.wg-sponsor>span{font-size:8px;color:#72857c;font-weight:700;letter-spacing:.08em}.wg-sponsor b{color:#613632;font-size:19px;font-weight:800;letter-spacing:-.07em}.wg-sponsor small{display:block;text-align:right;font-size:7px;letter-spacing:.04em}
.wg-wordmark{position:absolute;left:50%;transform:translateX(-50%);font:800 22px 'Outfit',sans-serif;color:#1c3430;text-decoration:none;letter-spacing:-.06em;white-space:nowrap}.wg-wordmark span{color:#45968a}
.wg-menu{position:absolute;right:20px;top:50%;transform:translateY(-50%);z-index:30;font:600 13px 'Outfit',sans-serif}.wg-menu summary{cursor:pointer;list-style:none;background:#edf5f1;border:1px solid #d9e9e0;border-radius:25px;color:#276a5d;padding:10px 15px}.wg-menu summary::-webkit-details-marker{display:none}
.wg-menu nav{position:absolute;right:0;top:calc(100% + 12px);min-width:245px;max-height:75vh;overflow:auto;display:flex;flex-direction:column;background:white;border:1px solid #dfebe4;border-radius:16px;box-shadow:0 18px 50px #1e403027;padding:10px}
.wg-menu nav a{font-size:13px;color:#2c4940;text-decoration:none;padding:10px 12px;border-radius:9px}.wg-menu nav a:hover{background:#eaf4f1;color:#2d8b78}.wg-menu-title{font-size:9px;color:#7d9990;letter-spacing:.1em;margin:14px 12px 4px;font-weight:800}
@media(max-width:1000px){.wg-logo img{width:100px}.wg-wordmark{font-size:19px}.wg-sponsor{display:none}.wg-separator{display:none}}
@media(max-width:640px){.wg-logo img{width:73px}.wg-wordmark{left:45%;font-size:18px}.wg-menu{right:7px}.wg-menu summary{padding:8px 10px;font-size:11px}}
</style>
---
const questions=[{group:"Localización",question:"¿Qué permite encontrar un producto de forma consistente?",options:["Confiar en quien lleva más tiempo","Asignar códigos visibles y ubicaciones registradas","Colocarlo siempre donde haya hueco"],answer:1,why:"Un sistema compartido de ubicaciones evita que el conocimiento dependa de una persona."},
{group:"Localización",question:"¿Qué debes registrar si un artículo cambia de almacén a tienda?",options:["El traslado y la nueva ubicación","Solo el nombre del empleado","Nada, si el producto sigue en el garden"],answer:0,why:"Los movimientos físicos deben actualizarse para mantener la trazabilidad."},
{group:"Localización",question:"¿Qué significa que haya stock en reserva y exposición?",options:["Que debe sumarse dos veces","Que una de las dos ubicaciones debe ignorarse","Que hay que registrar existencias y ubicaciones sin duplicar unidades"],answer:2,why:"Ubicaciones secundarias no implican inventario duplicado."},
{group:"Sobrestock",question:"¿Qué indica una cobertura de 20 semanas en un producto que vende 5 unidades por semana?",options:["Unas 100 unidades disponibles","Unas 25 unidades disponibles","Unas 4 unidades disponibles"],answer:0,why:"Cobertura = stock disponible / venta semanal; 20 × 5 = 100 unidades."},
{group:"Sobrestock",question:"¿Cuál es una primera medida adecuada ante exceso de stock?",options:["Liquidar inmediatamente todo","Revisar rotación y cobertura por referencia","Pedir más para obtener mejor precio"],answer:1,why:"Antes de actuar, conviene dimensionar el problema y sus causas."},
{group:"Sobrestock",question:"¿Por qué requiere especial vigilancia la planta viva?",options:["Porque su valor nunca cambia","Porque siempre tiene demanda constante","Porque puede deteriorarse y generar merma"],answer:2,why:"La perecibilidad exige ajustes de previsión, cuidado y rotación."},
{group:"Compras",question:"¿Qué tres datos ayudan a calcular un punto de pedido?",options:["Demanda, plazo de entrega y stock de seguridad","Precio de venta, margen y logo","Número de empleados, visitas y caja"],answer:0,why:"El punto de pedido orientativo suma demanda durante el plazo más reserva."},
{group:"Compras",question:"¿Qué hacer si un proveedor incumple plazos a menudo?",options:["Ignorar el problema","Revisar la variabilidad del plazo y la reserva de seguridad","Dejar de registrar entradas"],answer:1,why:"La fiabilidad del suministro influye en cuándo comprar y el riesgo de rotura."},
{group:"Compras",question:"¿Qué debe distinguir un plan de compras de campaña?",options:["Solo el importe total anual","Solo el precio de catálogo","La distribución temporal de la demanda"],answer:2,why:"Una campaña necesita la curva semanal, no solo una cifra anual."},
{group:"Conteos",question:"¿Qué es un conteo a ciegas?",options:["Contar sin mostrar al contador la cantidad teórica","Contar sin identificar el producto","Contar solo las referencias caras"],answer:0,why:"Ocultar las existencias teóricas reduce sesgos."},
{group:"Conteos",question:"¿Qué haces ante una discrepancia importante?",options:["Modificar sin dejar rastro","Recontar, investigar y autorizar el ajuste","Ignorarla hasta el año siguiente"],answer:1,why:"El control exige trazabilidad de la causa y aprobación de ajustes."},
{group:"Conteos",question:"¿Para qué sirve el conteo cíclico?",options:["Sustituir todas las ventas","Evitar registrar mermas","Revisar referencias por turnos durante el año"],answer:2,why:"Los ciclos permiten verificar progresivamente el inventario."},
{group:"Movimientos",question:"¿Qué debe comprobarse al recibir mercancía?",options:["Las unidades reales frente al albarán y al pedido","Solo la fecha de la factura","Solo el logotipo del proveedor"],answer:0,why:"La recepción debe conciliar cantidades y referencias realmente entregadas."},
{group:"Movimientos",question:"¿Qué debería ocurrir después de una venta en caja?",options:["Nada hasta el inventario anual","Descontar correctamente las unidades del stock","Sumar unidades al almacén"],answer:1,why:"Las ventas deben registrar su correspondiente salida."},
{group:"Movimientos",question:"¿Cómo deben tratarse las roturas y devoluciones?",options:["Sin registrar para ahorrar tiempo","Mezclándolas con las ventas normales","Con movimientos y motivos específicos"],answer:2,why:"Las causas permiten auditar y mejorar los procesos."}];
---
<section class="knowledgeExam" id="knowledgeExam">
 <div class="examHeader"><span>WIKIGARDEN · EVALUACIÓN DE CONOCIMIENTOS</span><h2>¿Cuánto sabes sobre gestión de inventarios?</h2><p>15 preguntas prácticas, tres por reto. Pon a prueba lo aprendido y consigue una medalla de conocimientos si aciertas al menos 12.</p><div class="examProgress"><span id="examStep">Pregunta 1 de 15</span><strong id="examPercent">0%</strong></div><div class="examTrack"><div id="examFill"></div></div></div>
 <div class="examQuestions">
 {questions.map((q,i)=><fieldset class="examQuestion" data-exam-question={i} hidden={i!==0}><legend><span class="examGroup">{q.group.toUpperCase()} · {i+1}/15</span><span class="examPrompt">{q.question}</span></legend><div class="examOptions">{q.options.map((option,j)=><label><input type="radio" name={'exam-'+i} value={j} /><span>{String.fromCharCode(65+j)}. {option}</span></label>)}</div></fieldset>)}
 </div>
 <p id="examAlert" class="examAlert" role="alert" aria-live="polite"></p>
 <div class="examNav" id="examNav"><button type="button" id="examPrev" disabled>← Anterior</button><button type="button" id="examNext">Siguiente →</button></div>
 <section class="examResults" id="examResults" hidden><div class="examResultMedal" id="examResultMedal">★</div><h2 id="examResultTitle"></h2><p id="examResultScore"></p><div id="examReview"></div><div class="examResultLinks"><button type="button" id="examAgain">Repetir evaluación</button><a href="/perfil/">Ver mi medallero →</a></div></section>
 </section>
<script is:inline>
(function(){
 const answers=[{"answer":1,"why":"Un sistema compartido de ubicaciones evita que el conocimiento dependa de una persona.","group":"Localización","question":"¿Qué permite encontrar un producto de forma consistente?"},{"answer":0,"why":"Los movimientos físicos deben actualizarse para mantener la trazabilidad.","group":"Localización","question":"¿Qué debes registrar si un artículo cambia de almacén a tienda?"},{"answer":2,"why":"Ubicaciones secundarias no implican inventario duplicado.","group":"Localización","question":"¿Qué significa que haya stock en reserva y exposición?"},{"answer":0,"why":"Cobertura = stock disponible / venta semanal; 20 × 5 = 100 unidades.","group":"Sobrestock","question":"¿Qué indica una cobertura de 20 semanas en un producto que vende 5 unidades por semana?"},{"answer":1,"why":"Antes de actuar, conviene dimensionar el problema y sus causas.","group":"Sobrestock","question":"¿Cuál es una primera medida adecuada ante exceso de stock?"},{"answer":2,"why":"La perecibilidad exige ajustes de previsión, cuidado y rotación.","group":"Sobrestock","question":"¿Por qué requiere especial vigilancia la planta viva?"},{"answer":0,"why":"El punto de pedido orientativo suma demanda durante el plazo más reserva.","group":"Compras","question":"¿Qué tres datos ayudan a calcular un punto de pedido?"},{"answer":1,"why":"La fiabilidad del suministro influye en cuándo comprar y el riesgo de rotura.","group":"Compras","question":"¿Qué hacer si un proveedor incumple plazos a menudo?"},{"answer":2,"why":"Una campaña necesita la curva semanal, no solo una cifra anual.","group":"Compras","question":"¿Qué debe distinguir un plan de compras de campaña?"},{"answer":0,"why":"Ocultar las existencias teóricas reduce sesgos.","group":"Conteos","question":"¿Qué es un conteo a ciegas?"},{"answer":1,"why":"El control exige trazabilidad de la causa y aprobación de ajustes.","group":"Conteos","question":"¿Qué haces ante una discrepancia importante?"},{"answer":2,"why":"Los ciclos permiten verificar progresivamente el inventario.","group":"Conteos","question":"¿Para qué sirve el conteo cíclico?"},{"answer":0,"why":"La recepción debe conciliar cantidades y referencias realmente entregadas.","group":"Movimientos","question":"¿Qué debe comprobarse al recibir mercancía?"},{"answer":1,"why":"Las ventas deben registrar su correspondiente salida.","group":"Movimientos","question":"¿Qué debería ocurrir después de una venta en caja?"},{"answer":2,"why":"Las causas permiten auditar y mejorar los procesos.","group":"Movimientos","question":"¿Cómo deben tratarse las roturas y devoluciones?"}];
 function init(){
  const root=document.getElementById('knowledgeExam');if(!root||root.dataset.ready)return;root.dataset.ready='1';
  const items=[...root.querySelectorAll('[data-exam-question]')];const next=root.querySelector('#examNext'),prev=root.querySelector('#examPrev'),alert=root.querySelector('#examAlert'),nav=root.querySelector('#examNav'),result=root.querySelector('#examResults');let step=0;
  function draw(){items.forEach((el,i)=>el.hidden=i!==step);prev.disabled=step===0;next.textContent=step===14?'Ver mis resultados →':'Siguiente →';root.querySelector('#examStep').textContent='Pregunta '+(step+1)+' de 15';const answered=items.filter(x=>x.querySelector('input:checked')).length;root.querySelector('#examPercent').textContent=Math.round(answered/15*100)+'%';root.querySelector('#examFill').style.width=(answered/15*100)+'%';alert.textContent='';}
  root.addEventListener('change',draw);
  prev.addEventListener('click',()=>{step=Math.max(0,step-1);draw()});
  next.addEventListener('click',()=>{if(!items[step].querySelector('input:checked')){alert.textContent='Selecciona una respuesta para continuar.';return;}if(step<14){step++;draw();return;}let correct=0;const review=[];
   items.forEach((el,i)=>{const v=Number(el.querySelector('input:checked').value);if(v===answers[i].answer)correct++;else review.push(answers[i]);});
   const passed=correct>=12;try{const old=JSON.parse(localStorage.getItem('wikigarden:knowledge-exam:v1')||'null');localStorage.setItem('wikigarden:knowledge-exam:v1',JSON.stringify({score:Math.max(correct,old?.score||0),passed:passed||old?.passed||false,completed:true,date:new Date().toISOString()}));}catch(e){}
   items.forEach(el=>el.hidden=true);nav.hidden=true;result.hidden=false;
   result.querySelector('#examResultMedal').classList.toggle('unlocked',passed);
   result.querySelector('#examResultTitle').textContent=passed?'¡Enhorabuena! Medalla desbloqueada.':'Buen intento. Puedes seguir mejorando.';
   result.querySelector('#examResultScore').textContent=correct+' respuestas correctas de 15. '+(passed?'Has superado la evaluación.':'Necesitas al menos 12 para desbloquear la medalla.');
   const wrap=root.querySelector('#examReview');wrap.replaceChildren();if(review.length){const h=document.createElement('h3');h.textContent='Repasa estas ideas';wrap.append(h);review.forEach(q=>{const p=document.createElement('p');p.textContent=q.group+' · '+q.question+' — '+q.why;wrap.append(p)})}else{wrap.textContent='¡Todas las respuestas correctas!'}
   result.scrollIntoView({behavior:'smooth',block:'start'});
  });
  root.querySelector('#examAgain').addEventListener('click',()=>{root.querySelectorAll('input').forEach(input=>input.checked=false);result.hidden=true;nav.hidden=false;step=0;draw();root.scrollIntoView({behavior:'smooth',block:'start'})});draw();
 }
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});else init();document.addEventListener('astro:page-load',init);
})();
</script>
<style is:global>
.knowledgeExam{font-family:Outfit,system-ui,sans-serif;color:#244a39}.examHeader{padding:27px;background:#eff8f0;border-radius:19px;border:1px solid #d6e9dc}.examHeader>span,.examGroup{font:800 11px Outfit,system-ui,sans-serif;color:#38836b;letter-spacing:.1em}.examHeader h2{font-size:clamp(24px,3vw,34px);margin:10px 0}.examHeader p{color:#637b6f;font-size:14px}.examProgress{display:flex;justify-content:space-between;font-size:12px;font-weight:800;margin-top:18px}.examTrack{height:9px;border-radius:20px;background:#daeade;margin-top:10px;overflow:hidden}.examTrack>div{height:100%;width:0;background:#3e9b75;transition:width .3s}
.examQuestion{margin:25px 0 10px!important;padding:24px!important;background:#fff;border:1px solid #e0eae4;border-radius:18px;min-width:0}.examQuestion[hidden]{display:none!important}.examQuestion legend{display:flex;flex-direction:column;gap:12px;padding:0;width:100%}.examPrompt{font-size:clamp(19px,2.5vw,25px);font-weight:800;line-height:1.3;color:#214c39}.examOptions{display:grid;gap:10px;margin-top:20px}.examOptions label{display:block;cursor:pointer}.examOptions input{position:absolute;opacity:0}.examOptions label span{display:block;background:#f7faf8;border:1px solid #ddebe1;padding:15px;border-radius:12px;font-weight:600;font-size:14px}.examOptions input:checked+span{background:#e1f4e6;border-color:#37966f;color:#216848}.examOptions input:focus-visible+span{outline:2px solid #327b5e}.examNav{display:flex;justify-content:space-between;margin:16px 0 25px}.examNav button,.examResultLinks button,.examResultLinks a{padding:12px 19px;border-radius:25px;border:1px solid #c6e0ce;background:#fff;color:#287c5d;font:800 13px Outfit,system-ui,sans-serif;cursor:pointer}.examNav button:last-child{background:#358766;color:white}.examNav button:disabled{opacity:.35}.examAlert{font-size:12px;color:#9b4b26}.examResults{background:#f2f8f2;padding:28px;border:1px solid #d5e9da;border-radius:18px;margin-top:20px}.examResults[hidden]{display:none!important}.examResultMedal{display:grid;place-items:center;width:100px;height:100px;border-radius:50%;background:#c9cbca;color:white;filter:grayscale(1);font-size:45px}.examResultMedal.unlocked{background:radial-gradient(circle at 25% 25%,#ffec80,#dba62a);border:5px solid #f4dc7a;filter:none}.examResults h2{margin:16px 0}.examResults p{font-size:14px;color:#567268;line-height:1.6}.examResultLinks{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.examResultLinks a{text-decoration:none}
</style>